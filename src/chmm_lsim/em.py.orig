"""EM for LSIM (`em_lsim.m`): shared M-step, AIC/BIC, best-iterate tracking.

The E-step is one forward-backward call per trial, dispatched through
`backends.base.run_backend(backend, fb_constants.variant, ...)` (P3b's
variant axis and P7's execution-backend axis both apply here) --
Raw POISE is the default inference variant. Explicit `variant="sed"` and
`variant="fast"` also run end-to-end through the
same `e_step`/`em_lsim`, on either `backend="numpy"`
(the default) or `backend="numba"`, reduced into
`ExpectedStats` -- fixed-size sufficient statistics, independent of `T_all`
(§2.4.2), so a chunked/streamed caller (P8) can accumulate them without ever
materialising a `(S, T_all)` array. `left2right`'s only effect (§0.4.8) is a
one-time smoothing of a raw `init_model`'s `pi_0` into the *effective*
parameters iteration 1's E-step actually runs on; `em_lsim`'s own `pi_0`
update every iteration is unconditionally `mean(gamma_p0)` (MATLAB's
conditional preservation of it under `left2right` is commented out in
`em_lsim.m`, so nothing here reproduces it).

**Raw vs finalized, explicitly.** `e_step` (and its per-channel accumulator)
returns *raw* stats: every field is a plain sum or a mergeable central-moment
triple, so two raw `ExpectedStats` from disjoint chunks of trials can be
combined with `merge_expected_stats` before anything derived is computed.
`finalize_expected_stats` is the one place `nanvar_y`, the two fallback
flags, and `gamma_p0` get computed -- from the (possibly merged) raw
accumulators -- and must run exactly once, after all merging, before `m_step`.

**Central moments, not raw moments (§2.4.2, corrected).** MATLAB's own M-step
computes `mu` and `sigma` by *directly recentering* observed data around a
mean -- it never forms `Σy²` and subtracts. A naive port that accumulates
`Σy`, `Σy²` and later computes `Σy² - 2·μ·Σy + μ²·Σw` is algebraically
identical but catastrophically unstable once `y` sits far from zero (the
`Σy²` term and the correction terms are each `O(offset²)`, and subtracting
two such terms to recover an `O(variance)` result loses precision
proportional to `offset²/variance`). Every accumulator below is instead a
*central* moment -- a running `(weight, mean, M2)` triple (Welford/Chan) for
the diagonal case, or a running `(Q, M, C)` pairwise triple for the full
case -- combined via the mergeable parallel-variance formula, so precision
stays proportional to the data's own scale, not its offset from zero.
"""

from __future__ import annotations

import concurrent.futures
import multiprocessing
import warnings
from collections import deque
from dataclasses import dataclass, field
from dataclasses import replace as dataclasses_replace

import numpy as np
from numpy.typing import NDArray

from chmm_lsim.backends.base import UnsupportedCombination, run_backend
from chmm_lsim.backends.numpy_ import block_sum, build_W
from chmm_lsim.compat import FbConstants
from chmm_lsim.params import ChannelGMM, LSIMParams
from chmm_lsim.structure import LSIMStructure
from chmm_lsim.validate import (
    ValidationError,
    _is_prevalidated,
    _iter_validated_observation_chunks,
    _ValidatedTrials,
    validate_observation_list,
    validate_observations,
)

_EPS = float(np.finfo(np.float64).eps)
_LOW_MASS_GAMMA_THRESHOLD = 1e-8
_LOW_MASS_STATE_COUNT = 3
_SIGMA_RIDGE = 0.001
_VALID_EXECUTORS = ("thread", "process")
_IN_FLIGHT_MULTIPLIER = 2  # bounded-scheduling window width, in units of n_jobs -- see _run_parallel_e_step


@dataclass
class ChannelExpectedStats:
    """Raw, mergeable sufficient statistics for one channel's GMM M-step
    (§2.4.2). Every field is either a plain sum or a central-moment triple
    combined via the mergeable parallel-variance formula -- never a raw
    `Σy`/`Σy²` moment -- so this object's size is independent of `T_all` and
    it can be combined with another chunk's via `merge_channel_stats`.
    `nanvar_y`, `fallback_mu` and `fallback_sigma_full` are `None` until
    `finalize_channel_stats` runs -- they are *derived*, not accumulated.

    **Diagonal channels** (`sigma_diag=True`) use the per-`(state,component,
    dim)` univariate triples `weighted_W`/`weighted_mean`/`weighted_M2`
    (weight `= γ·o`); `pairwise_*` fields are `None`.

    **Full-covariance channels** use the per-`(state,component)` pairwise
    tensors `pairwise_Q`/`pairwise_M`/`pairwise_C` (weight `= γ`,
    co-observation mask `o_i·o_j`) for *everything*, including `mu` (its
    diagonal `M[i,i]` is exactly the univariate weighted mean); `weighted_*`
    fields are `None`.

    Both share `n_obs`/`welford_mean`/`welford_M2` (observed-only, per
    channel dimension -- feeds `nanvar_y`'s `0.001·var` ridge and the
    `matlab_compat=False` fallback denominator) and `allzero_n`/
    `allzero_mean`/`allzero_M2` (over *every* `T_all` timestep with missing
    values zero-filled, weight 1 -- feeds the canonical `matlab_compat=True`
    fallback, matching `em_lsim.m`'s literal "add 1 to every cell after
    zero-filling"). Full covariance additionally carries the *unweighted*
    pairwise tensor `u_pairwise_Q`/`u_pairwise_M`/`u_pairwise_C` for its own
    independent fallback (§0.4.2's denominator disagreement; the denominator
    itself stays `resp + T_all`, unmasked, matching canonical MATLAB, not
    `u_pairwise_Q`).
    """

    resp: NDArray[np.float64]  # (M_c,K_c) = Σ_t γ[s,k,t]
    resp_pos: NDArray[np.int64]  # (M_c,K_c) = #{t: γ[s,k,t] > 1e-8}
    n_w_pos_diag: NDArray[np.int64]  # (M_c,K_c) = #{(dim,t): γ·o > 0}
    n_w_pos_full: NDArray[np.int64]  # (M_c,K_c) = d_c * #{t: γ > 0}

    # diagonal-only (None for full-covariance channels):
    weighted_W: NDArray[np.float64] | None  # (M_c,K_c,d_c) = Σ_t γ·o
    weighted_mean: NDArray[np.float64] | None  # (M_c,K_c,d_c)
    weighted_M2: NDArray[np.float64] | None  # (M_c,K_c,d_c) = Σ_t γ·o·(y-mean)²

    # full-covariance-only (None for diagonal channels):
    pairwise_Q: NDArray[np.float64] | None  # (M_c,K_c,d_c,d_c) = Σ_t γ·o_i·o_j
    pairwise_M: NDArray[np.float64] | None  # (M_c,K_c,d_c,d_c) weighted pairwise mean of y_i under mask (i,j)
    pairwise_C: NDArray[np.float64] | None  # (M_c,K_c,d_c,d_c) weighted pairwise central cross-moment
    u_pairwise_Q: NDArray[np.float64] | None  # (d_c,d_c) = Σ_t o_i·o_j, unweighted, per channel
    u_pairwise_M: NDArray[np.float64] | None  # (d_c,d_c)
    u_pairwise_C: NDArray[np.float64] | None  # (d_c,d_c)

    # shared (both diag and full), per channel:
    n_obs: NDArray[np.float64]  # (d_c,) = Σ_t o -- observed-timestep count
    welford_mean: NDArray[np.float64]  # (d_c,) running mean of observed y, parallel-mergeable
    welford_M2: NDArray[np.float64]  # (d_c,) running Σ(y-mean)² of observed y, parallel-mergeable
    allzero_n: NDArray[np.float64]  # (d_c,) == running T_all (same for every dim; kept per-dim for uniform merging)
    allzero_mean: NDArray[np.float64]  # (d_c,) running mean over every T_all timestep, missing=0
    allzero_M2: NDArray[np.float64]  # (d_c,) running Σ(y_zerofilled-mean)² over every T_all timestep

    # derived -- None until finalize_channel_stats:
    nanvar_y: NDArray[np.float64] | None = None  # (d_c,) sample variance, omitnan, ddof=1, MATLAB's n=1->0 convention
    fallback_mu: NDArray[np.bool_] | None = None  # (M_c,K_c)
    fallback_sigma_full: NDArray[np.bool_] | None = None  # (M_c,K_c), None when diagonal


@dataclass
class ExpectedStats:
    """Raw, mergeable sufficient statistics from one E-step (or a merge of
    several). `gamma_p0` is `None` until `finalize_expected_stats` computes
    it from `gamma_first`/`n_trials` -- see the module docstring."""

    zeta: NDArray[np.float64]  # (S,S) W-weighted transition posterior mass, summed over t and trials
    gamma_first: NDArray[np.float64]  # (S,) Σ over trials of gamma[:, 0] -- NOT divided by n_trials
    gamma_sum: NDArray[np.float64]  # (S,) Σ_t gamma, all trials -- pi_steady, diagnostics
    n_trials: int
    n_transitions: int  # L_T_1 = sum_trials(T_r - 1)
    T_all: int
    loglik: float  # sum over trials of P_O_model
    channels: list[ChannelExpectedStats]
    gamma_p0: NDArray[np.float64] | None = None  # (S,) derived: gamma_first / n_trials


def _empty_channel_stats(M_c: int, K_c: int, d_c: int, sigma_diag: bool) -> ChannelExpectedStats:
    pair_shape = (M_c, K_c, d_c, d_c)
    return ChannelExpectedStats(
        resp=np.zeros((M_c, K_c)),
        resp_pos=np.zeros((M_c, K_c), dtype=np.int64),
        n_w_pos_diag=np.zeros((M_c, K_c), dtype=np.int64),
        n_w_pos_full=np.zeros((M_c, K_c), dtype=np.int64),
        weighted_W=np.zeros((M_c, K_c, d_c)) if sigma_diag else None,
        weighted_mean=np.zeros((M_c, K_c, d_c)) if sigma_diag else None,
        weighted_M2=np.zeros((M_c, K_c, d_c)) if sigma_diag else None,
        pairwise_Q=None if sigma_diag else np.zeros(pair_shape),
        pairwise_M=None if sigma_diag else np.zeros(pair_shape),
        pairwise_C=None if sigma_diag else np.zeros(pair_shape),
        u_pairwise_Q=None if sigma_diag else np.zeros((d_c, d_c)),
        u_pairwise_M=None if sigma_diag else np.zeros((d_c, d_c)),
        u_pairwise_C=None if sigma_diag else np.zeros((d_c, d_c)),
        n_obs=np.zeros(d_c),
        welford_mean=np.zeros(d_c),
        welford_M2=np.zeros(d_c),
        allzero_n=np.zeros(d_c),
        allzero_mean=np.zeros(d_c),
        allzero_M2=np.zeros(d_c),
    )


def _welford_batch(weight: NDArray[np.float64], value: NDArray[np.float64]) -> tuple[NDArray, NDArray, NDArray]:
    """One batch's `(W, mean, M2)` along the last axis, for a general
    non-negative `weight` (a boolean/0-1 mask is the special case of an
    observed-count accumulator; `weight≡1` is the special case of a plain,
    unweighted accumulator over every column). `value` must already be
    NaN-free (zero-filled at any position `weight` doesn't count) --
    `weight * value` with a real `NaN` stays `NaN` even at zero weight."""
    W = weight.sum(axis=-1)
    with np.errstate(invalid="ignore", divide="ignore"):
        mean = np.divide((weight * value).sum(axis=-1), W, out=np.zeros_like(W), where=W > 0)
    diff = value - mean[..., None]
    M2 = np.sum(weight * diff**2, axis=-1)
    return W, mean, M2


def _welford_merge(
    W_a: NDArray, mean_a: NDArray, M2_a: NDArray, W_b: NDArray, mean_b: NDArray, M2_b: NDArray
) -> tuple[NDArray, NDArray, NDArray]:
    """Chan et al.'s parallel-variance merge, vectorized -- the mergeable form
    of Welford's algorithm, avoiding the Σy² cancellation a naive
    `Σy² - (Σy)²/n` formula suffers when `y` is far from zero. `W` is a
    general weight (a count is the special case of `weight≡1`)."""
    W = W_a + W_b
    delta = mean_b - mean_a
    with np.errstate(invalid="ignore", divide="ignore"):
        mean = mean_a + np.divide(delta * W_b, W, out=np.zeros_like(W, dtype=np.float64), where=W > 0)
        M2 = M2_a + M2_b + np.divide(delta**2 * W_a * W_b, W, out=np.zeros_like(W, dtype=np.float64), where=W > 0)
    return W, mean, M2


def _pairwise_batch(
    weight: NDArray[np.float64], o: NDArray[np.bool_], Y_masked: NDArray[np.float64]
) -> tuple[NDArray, NDArray, NDArray]:
    """One batch's `(Q, M, C)` pairwise triple (the bivariate generalization
    of `_welford_batch`): `Q[i,j] = Σ_t weight(t)·o_i(t)·o_j(t)`, `M[i,j]` the
    weighted mean of `y_i` under that mask, `C[i,j] = Σ_t
    weight·o_i·o_j·(y_i-M[i,j])·(y_j-M[j,i])` -- computed by directly
    recentering (never forming a `y_i·y_j` raw moment), fully vectorized via
    a `(d,d,T)` broadcast rather than a `(d,d)` Python loop."""
    o_f = o.astype(np.float64)
    wo = weight[None, :] * o_f  # (d,T)
    Q = wo @ o_f.T  # (d,d)
    num_M = (wo * Y_masked) @ o_f.T  # (d,d)
    M = np.divide(num_M, Q, out=np.zeros_like(Q), where=Q > 0)
    Y_diff = Y_masked[:, None, :] - M[:, :, None]  # (d,d,T): [i,j,t] = y_i(t) - M[i,j]
    Y_diff_partner = np.transpose(Y_diff, (1, 0, 2))  # [i,j,t] = y_j(t) - M[j,i]
    weight_full = weight[None, None, :] * o_f[:, None, :] * o_f[None, :, :]  # (d,d,T)
    C = np.sum(weight_full * Y_diff * Y_diff_partner, axis=2)
    return Q, M, C


def _pairwise_merge(
    Q_a: NDArray, M_a: NDArray, C_a: NDArray, Q_b: NDArray, M_b: NDArray, C_b: NDArray
) -> tuple[NDArray, NDArray, NDArray]:
    """Bivariate parallel merge of two `(Q,M,C)` triples. `Q[i,j]` merges as
    a plain sum; `M[i,j]` merges as an ordinary univariate weighted mean
    (weight `Q[i,j]`); `C[i,j]` needs *both* deltas -- `M_b[i,j]-M_a[i,j]`
    (this pair's own mean-of-`i`) and `M_b[j,i]-M_a[j,i]` (the mean-of-`j`
    stored at the transposed entry, since mask `o_i·o_j` is symmetric).

    Works both on a single `(d,d)` pair-tensor and on a batched
    `(...,d,d)` one (`merge_channel_stats` merges all `(state,component)`
    pairs at once) -- `.swapaxes(-1,-2)`, not `.T`, since plain `.T` on an
    N-d array reverses *every* axis, not just the last two.
    """
    Q = Q_a + Q_b
    delta_i = M_b - M_a
    delta_j = delta_i.swapaxes(-1, -2)
    with np.errstate(invalid="ignore", divide="ignore"):
        M = M_a + np.divide(delta_i * Q_b, Q, out=np.zeros_like(Q), where=Q > 0)
        C = C_a + C_b + np.divide(delta_i * delta_j * Q_a * Q_b, Q, out=np.zeros_like(Q), where=Q > 0)
    return Q, M, C


def _accumulate_channel_trial(
    stats: ChannelExpectedStats, structure: LSIMStructure, zee: int, post, Y_trial: NDArray[np.float64], sigma_diag: bool
) -> None:
    """Adds one trial's contribution to `stats`, in place."""
    zee_sl = structure.state_slice(zee)
    dim_sl = structure.dim_slice(zee)
    M_zee = structure.channel_state_num[zee]
    K_zee = structure.num_gmm_component[zee]

    Y_c = Y_trial[dim_sl, :]  # (d_c, T)
    o = ~np.isnan(Y_c)  # (d_c, T)
    o_f = o.astype(np.float64)
    Y_masked = np.where(o, Y_c, 0.0)
    T = Y_c.shape[1]

    obs_W, obs_mean, obs_M2 = _welford_batch(o_f, Y_masked)
    stats.n_obs, stats.welford_mean, stats.welford_M2 = _welford_merge(
        stats.n_obs, stats.welford_mean, stats.welford_M2, obs_W, obs_mean, obs_M2
    )

    allzero_W, allzero_mean, allzero_M2 = _welford_batch(np.ones_like(Y_masked), Y_masked)
    stats.allzero_n, stats.allzero_mean, stats.allzero_M2 = _welford_merge(
        stats.allzero_n, stats.allzero_mean, stats.allzero_M2, allzero_W, allzero_mean, allzero_M2
    )

    if not sigma_diag:
        u_Q, u_M, u_C = _pairwise_batch(np.ones(T), o, Y_masked)
        stats.u_pairwise_Q, stats.u_pairwise_M, stats.u_pairwise_C = _pairwise_merge(
            stats.u_pairwise_Q, stats.u_pairwise_M, stats.u_pairwise_C, u_Q, u_M, u_C
        )

    for i in range(M_zee):
        state_idx = zee_sl.start + i
        gamma_state = post.gamma[state_idx, :]
        B_state = post.B[state_idx, :]
        for k in range(K_zee):
            ratio = np.divide(
                post.B_comp[state_idx, k, :], B_state, out=np.full_like(B_state, np.nan), where=B_state != 0
            )
            g = gamma_state * ratio
            g = np.where(np.isnan(g), 0.0, g)  # (T,)

            stats.resp[i, k] += np.sum(g)
            stats.resp_pos[i, k] += int(np.sum(g > _LOW_MASS_GAMMA_THRESHOLD))
            stats.n_w_pos_diag[i, k] += int(np.sum(o & (g[None, :] > 0)))
            stats.n_w_pos_full[i, k] += Y_c.shape[0] * int(np.sum(g > 0))

            if sigma_diag:
                gW, gmean, gM2 = _welford_batch(g[None, :] * o_f, Y_masked)
                stats.weighted_W[i, k], stats.weighted_mean[i, k], stats.weighted_M2[i, k] = _welford_merge(
                    stats.weighted_W[i, k], stats.weighted_mean[i, k], stats.weighted_M2[i, k], gW, gmean, gM2
                )
            else:
                gQ, gM, gC = _pairwise_batch(g, o, Y_masked)
                stats.pairwise_Q[i, k], stats.pairwise_M[i, k], stats.pairwise_C[i, k] = _pairwise_merge(
                    stats.pairwise_Q[i, k], stats.pairwise_M[i, k], stats.pairwise_C[i, k], gQ, gM, gC
                )


def _merge_field(chunks: list, get, *, pairwise: bool) -> tuple:
    """Reduces `[get(c) for c in chunks]` (each a `(W,mean,M2)` triple, or --
    when `pairwise=True` -- a `(Q,M,C)` triple) with the appropriate merge,
    left to right. `pairwise` is passed explicitly rather than guessed from
    shape: a `(M_c,K_c,d_c)` univariate triple and a `(d_c,d_c)` pairwise one
    aren't reliably distinguishable by shape alone (`K_c` can equal `d_c`)."""
    triples = [get(c) for c in chunks]
    W, mean, M2 = triples[0]
    merge = _pairwise_merge if pairwise else _welford_merge
    for w, m, m2 in triples[1:]:
        W, mean, M2 = merge(W, mean, M2, w, m, m2)
    return W, mean, M2


def merge_channel_stats(chunks: list[ChannelExpectedStats]) -> ChannelExpectedStats:
    """Combines raw (unfinalized) per-channel stats from disjoint chunks of
    trials. Raises if any chunk was already finalized -- merging derived
    fields (a mean, a boolean trigger) by summing them would be wrong."""
    if any(c.nanvar_y is not None for c in chunks):
        raise ValueError("merge_channel_stats requires raw (unfinalized) stats -- finalize only after merging")
    sigma_diag = chunks[0].weighted_W is not None

    n_obs, w_mean, w_M2 = _merge_field(chunks, lambda c: (c.n_obs, c.welford_mean, c.welford_M2), pairwise=False)
    az_n, az_mean, az_M2 = _merge_field(chunks, lambda c: (c.allzero_n, c.allzero_mean, c.allzero_M2), pairwise=False)

    if sigma_diag:
        weighted_W, weighted_mean, weighted_M2 = _merge_field(
            chunks, lambda c: (c.weighted_W, c.weighted_mean, c.weighted_M2), pairwise=False
        )
        pairwise_Q = pairwise_M = pairwise_C = None
        u_Q = u_M = u_C = None
    else:
        weighted_W = weighted_mean = weighted_M2 = None
        pairwise_Q, pairwise_M, pairwise_C = _merge_field(
            chunks, lambda c: (c.pairwise_Q, c.pairwise_M, c.pairwise_C), pairwise=True
        )
        u_Q, u_M, u_C = _merge_field(chunks, lambda c: (c.u_pairwise_Q, c.u_pairwise_M, c.u_pairwise_C), pairwise=True)

    return ChannelExpectedStats(
        resp=sum(c.resp for c in chunks),
        resp_pos=sum(c.resp_pos for c in chunks),
        n_w_pos_diag=sum(c.n_w_pos_diag for c in chunks),
        n_w_pos_full=sum(c.n_w_pos_full for c in chunks),
        weighted_W=weighted_W,
        weighted_mean=weighted_mean,
        weighted_M2=weighted_M2,
        pairwise_Q=pairwise_Q,
        pairwise_M=pairwise_M,
        pairwise_C=pairwise_C,
        u_pairwise_Q=u_Q,
        u_pairwise_M=u_M,
        u_pairwise_C=u_C,
        n_obs=n_obs,
        welford_mean=w_mean,
        welford_M2=w_M2,
        allzero_n=az_n,
        allzero_mean=az_mean,
        allzero_M2=az_M2,
    )


def _nanvar_from_welford(n_obs: NDArray[np.float64], welford_M2: NDArray[np.float64]) -> NDArray[np.float64]:
    """MATLAB's `var(y, [], 2, 'omitnan')` from a merged observed-only
    Welford `(n_obs, welford_M2)` pair: sample variance (`ddof=1`) where
    `n_obs>1`, `0.0` (not `NaN`) where `n_obs==1` (MATLAB's own convention,
    confirmed directly against MATLAB: `var([5],[],2,'omitnan')==0`), and
    `NaN` where `n_obs==0`. Shared by `finalize_channel_stats` (from a
    mini-batch/full-dataset E-step's own accumulators) and `compute_global_
    nanvar` (accumulated directly from `Y_trials`, no E-step at all) -- one
    formula, not two copies that could drift apart."""
    nanvar_y = np.full_like(n_obs, np.nan)
    nanvar_y = np.where(n_obs > 1, np.divide(welford_M2, np.maximum(n_obs - 1, 1)), nanvar_y)
    nanvar_y = np.where(n_obs == 1, 0.0, nanvar_y)
    return nanvar_y


def finalize_channel_stats(stats: ChannelExpectedStats, *, sigma_diag: bool) -> ChannelExpectedStats:
    """Computes `nanvar_y` (from the merged observed-only Welford state,
    MATLAB's `n_obs==1 -> 0` convention, `n_obs==0 -> NaN`) and the two
    independent fallback flags (§0.4.3), once, after all merging. Returns a
    new object rather than mutating -- a finalized `ChannelExpectedStats` is
    a distinct state from a raw one (`merge_channel_stats` rejects the latter)."""
    n_obs = stats.n_obs
    nanvar_y = _nanvar_from_welford(n_obs, stats.welford_M2)

    d_c = n_obs.shape[0]
    fallback_mu = (stats.resp_pos <= _LOW_MASS_STATE_COUNT) | (stats.n_w_pos_diag < 2 * d_c)
    fallback_sigma_full = None if sigma_diag else ((stats.resp_pos <= _LOW_MASS_STATE_COUNT) | (stats.n_w_pos_full < 2 * d_c))

    return dataclasses_replace(stats, nanvar_y=nanvar_y, fallback_mu=fallback_mu, fallback_sigma_full=fallback_sigma_full)


def merge_expected_stats(chunks: list[ExpectedStats]) -> ExpectedStats:
    """Combines raw (unfinalized) `ExpectedStats` from disjoint chunks of
    trials -- e.g. from separate calls to `e_step` on different subsets of
    `Y_trials` (P8's chunked/streamed path). Raises if any chunk was already
    finalized."""
    if any(c.gamma_p0 is not None for c in chunks):
        raise ValueError("merge_expected_stats requires raw (unfinalized) stats -- finalize only after merging")
    n_channels = len(chunks[0].channels)
    merged_channels = [merge_channel_stats([c.channels[ci] for c in chunks]) for ci in range(n_channels)]
    return ExpectedStats(
        zeta=sum(c.zeta for c in chunks),
        gamma_first=sum(c.gamma_first for c in chunks),
        gamma_sum=sum(c.gamma_sum for c in chunks),
        n_trials=sum(c.n_trials for c in chunks),
        n_transitions=sum(c.n_transitions for c in chunks),
        T_all=sum(c.T_all for c in chunks),
        loglik=sum(c.loglik for c in chunks),
        channels=merged_channels,
    )


def finalize_expected_stats(stats: ExpectedStats, *, sigma_diag: bool) -> ExpectedStats:
    """Computes `gamma_p0` and every channel's derived fields, once, after
    all merging. Returns a new object (see `finalize_channel_stats`)."""
    gamma_p0 = stats.gamma_first / stats.n_trials
    channels = [finalize_channel_stats(c, sigma_diag=sigma_diag) for c in stats.channels]
    return dataclasses_replace(stats, gamma_p0=gamma_p0, channels=channels)


class TrialExecutionError(RuntimeError):
    """Raised by `e_step`'s parallel (`n_jobs>1`) path when a worker trial
    itself raises. Wraps the original exception (available as
    `original_exception`, chained via `raise ... from`) and records which
    trial -- by its 0-based position in the `Y_trials` list passed to
    `e_step`, not a completion-order position -- failed.

    Every not-yet-STARTED trial (queued in the pool but not yet picked up by
    a worker) is cancelled before this is raised (§P10b: "worker exceptions
    must cancel pending work and be re-raised with the original trial
    index") -- with the bounded in-flight scheduling `_run_parallel_e_step`
    uses (§P10b correction round), at most `_IN_FLIGHT_MULTIPLIER * n_jobs`
    trials are ever queued/running at once, so this failure mode wastes at
    most that many trials' worth of work, not the entire remaining dataset.
    A trial that is already RUNNING when the exception is detected cannot be
    interrupted by the stdlib executors -- and, since `_run_parallel_e_step`
    exits its executor's own `with` block on the way out (whether or not an
    exception is propagating), `Executor.__exit__` calls `shutdown(wait=
    True)`, which BLOCKS until every such already-running trial actually
    finishes. So this exception does **not** surface to the caller while
    other trials continue in the background: by the time `e_step` raises
    `TrialExecutionError`, every trial that was already running has already
    completed (or itself raised) -- only cancelled, not-yet-started trials
    are skipped, and every trial's *result* past the failing one, running or
    cancelled, is discarded either way."""

    def __init__(self, trial_index: int, original_exception: BaseException) -> None:
        super().__init__(f"trial index {trial_index} (0-based, into the Y_trials list passed to e_step) raised {type(original_exception).__name__}: {original_exception}")
        self.trial_index = trial_index
        self.original_exception = original_exception


def _validate_n_jobs_executor(n_jobs: int, executor: str | None, backend: str) -> None:
    """Strict, fail-loud validation for `e_step`'s `n_jobs`/`executor`
    axis -- never silently ignores an inconsistent combination (§P10b).
    `backend="torch"` owns its own batch/device parallelism inside
    `forward_backward_batch` (`chunk_size`/`max_memory_bytes`, an
    execution-memory control, never a trial-concurrency one); stacking an
    outer CPU executor on top of it would duplicate the model, oversubscribe
    CPU threads, or create multiple CUDA contexts, so it is rejected
    outright rather than downgraded to `n_jobs=1` behind the caller's back."""
    if isinstance(n_jobs, bool) or not isinstance(n_jobs, int) or n_jobs < 1:
        raise ValueError(f"n_jobs must be a positive int, got {n_jobs!r}")
    if executor is not None and executor not in _VALID_EXECUTORS:
        raise ValueError(f"executor must be one of {_VALID_EXECUTORS} or None, got {executor!r}")
    if backend == "torch":
        if n_jobs != 1 or executor is not None:
            raise UnsupportedCombination(
                f"backend='torch' does not support an outer CPU executor (n_jobs={n_jobs!r}, executor={executor!r}) -- "
                f"it already owns its own batch/device parallelism inside forward_backward_batch (chunk_size/"
                f"max_memory_bytes); pass n_jobs=1, executor=None for backend='torch', or use a CPU backend "
                f"(numpy/numba) for outer trial concurrency"
            )
        return
    if n_jobs == 1:
        if executor is not None:
            raise ValueError(
                f"executor={executor!r} was given but n_jobs=1 runs the serial reference path, which has no "
                f"executor to apply it to -- pass n_jobs>1 to use executor={executor!r}, or drop executor"
            )
    elif executor is None:
        raise ValueError(
            f"n_jobs={n_jobs} requires an explicit executor -- pass executor='thread' or executor='process' "
            f"(never inferred from backend={backend!r} or from n_jobs alone)"
        )


def _e_step_one_trial(
    structure: LSIMStructure,
    params: LSIMParams,
    Y: NDArray[np.float64],
    fb_constants: FbConstants,
    W: NDArray[np.float64],
    *,
    backend: str,
    validate: str,
) -> ExpectedStats:
    """One trial's own raw, unfinalized `ExpectedStats` (`n_trials=1`) --
    the parallel-execution counterpart of a single iteration of `e_step`'s
    own serial `for Y in Y_trials` loop body below, factored out to a plain
    module-level function (not a closure) so it is picklable and can run
    inside a `ProcessPoolExecutor` worker. `W` is passed in rather than
    recomputed per trial -- it depends only on `structure`/`params`, not on
    `Y`, so every trial (and every worker) shares the exact same array.

    Returns a value with the same `ExpectedStats.zeta` contract as the
    serial path (already `W`-weighted) -- `merge_expected_stats` sums this
    field in place across trials, and `(a+b)*W` and `a*W+b*W` agree only to
    within a few ULP in floating point, not bit-for-bit, so a parallel-path
    result is verified against the serial reference at a measured tolerance,
    never with `n_jobs=1`'s own exact reproducibility guarantee."""
    sigma_diag = params.sigma_diag
    channels = [
        _empty_channel_stats(
            structure.channel_state_num[c], structure.num_gmm_component[c], structure.channel_obs_dim[c], sigma_diag
        )
        for c in range(structure.C)
    ]
    zeta = np.zeros((structure.S, structure.S))
    gamma_first = np.zeros(structure.S)
    gamma_sum = np.zeros(structure.S)
    n_transitions = 0

    post = run_backend(backend, fb_constants.variant, structure, params, Y, fb_constants, validate=validate)
    T = Y.shape[1]
    gamma_first += post.gamma[:, 0]
    gamma_sum += post.gamma.sum(axis=1)
    if T > 1:
        abar = post.alpha[:, : T - 1] * post.scale[:, : T - 1]
        beta_next = post.beta[:, 1:]
        zeta += abar @ beta_next.T
        n_transitions = T - 1
    for c in range(structure.C):
        _accumulate_channel_trial(channels[c], structure, c, post, Y, sigma_diag)

    return ExpectedStats(
        zeta=zeta * W,
        gamma_first=gamma_first,
        gamma_sum=gamma_sum,
        n_trials=1,
        n_transitions=n_transitions,
        T_all=T,
        loglik=post.loglik,
        channels=channels,
    )


# ProcessPoolExecutor worker-process state: populated once per worker
# process (via `initializer=`/`initargs=`, at pool startup) rather than
# re-pickled on every single submitted trial -- `structure`/`params`/`W`
# are the same for every trial in one e_step call, so paying their
# pickling/unpickling cost once per worker process (not once per trial) is
# what the plan doc's own "array serialization" benchmark axis is about.
# Deliberately a plain module-level dict, not a class instance: each worker
# is a genuinely separate process (its own copy of this module's globals),
# so there is no cross-worker or cross-thread sharing to guard against here
# (contrast the thread-executor path below, which passes everything
# directly through `submit(...)` instead, since threads share memory with
# zero copying cost and a shared mutable global would risk cross-talk
# between concurrent `e_step` calls from different application threads).
_PROCESS_WORKER_CTX: dict = {}


def _process_worker_init(
    structure: LSIMStructure, params: LSIMParams, fb_constants: FbConstants, W: NDArray[np.float64], backend: str, validate: str
) -> None:
    _PROCESS_WORKER_CTX.update(structure=structure, params=params, fb_constants=fb_constants, W=W, backend=backend, validate=validate)


def _process_worker_run(Y: NDArray[np.float64]) -> ExpectedStats:
    ctx = _PROCESS_WORKER_CTX
    return _e_step_one_trial(ctx["structure"], ctx["params"], Y, ctx["fb_constants"], ctx["W"], backend=ctx["backend"], validate=ctx["validate"])


def _process_loglik_worker_init(structure: LSIMStructure, params: LSIMParams, fb_constants: FbConstants, backend: str, validate: str) -> None:
    _PROCESS_WORKER_CTX.update(structure=structure, params=params, fb_constants=fb_constants, backend=backend, validate=validate)


def _process_loglik_worker_run(Y: NDArray[np.float64]) -> float:
    from chmm_lsim.backends.base import run_backend_loglik

    ctx = _PROCESS_WORKER_CTX
    return run_backend_loglik(ctx["backend"], ctx["fb_constants"].variant, ctx["structure"], ctx["params"], Y, ctx["fb_constants"], validate=ctx["validate"])


def _resolve_start_method(start_method: str | None, executor: str | None) -> str | None:
    """P10e: the multiprocessing start method for `executor="process"` pools.

    `None` means the safe default, "spawn", on every platform. Spawned workers
    are fresh interpreters: they share no memory, native thread-pool state,
    locks or libffi closure allocator with the parent or with each other.

    Measured on the development cluster (system libffi 3.1, which every tested
    interpreter's `_ctypes` links): a minimal ctypes-callback workload with no
    lsim or numba code segfaults under "fork" on Python 3.12, 3.13 and 3.14,
    and under "forkserver" on Python 3.14; numba's llvmlite creates exactly
    such callbacks when loading kernels, and the P10e test suite reproduced a
    forkserver worker segfault inside llvmlite on 3.14. "spawn" passed
    everywhere. "forkserver" and "fork" remain available as explicit opt-ins
    (they start pools faster), for environments where they are known to be
    safe.

    A start method is only meaningful with executor="process"."""
    if start_method is None:
        return "spawn" if executor == "process" else None
    if executor != "process":
        raise ValueError(f"start_method={start_method!r} was given but executor={executor!r}; it only applies to executor='process'")
    if start_method not in multiprocessing.get_all_start_methods():
        raise ValueError(f"start_method must be one of {multiprocessing.get_all_start_methods()} or None, got {start_method!r}")
    return start_method


def _runner_validate(structure: LSIMStructure, params: LSIMParams, Y_trials, validate: str) -> str:
    """P10f: the `validate=` value the per-trial numpy/numba runners receive.
    For a private `_ValidatedTrials` snapshot (observations already validated
    once, at a training driver's boundary) with `validate="params"`, the
    parameters are validated here, once for this call, and the runners get
    `"off"` -- which skips only their per-trial `params.validate()` and
    `validate_observations` (for these runners `"params"` and `"off"` differ
    in nothing else). Any ordinary list, or `validate="all"`/`"off"`, is
    passed through unchanged."""
    if validate == "params" and _is_prevalidated(structure, Y_trials):
        params.validate()
        return "off"
    return validate


def _lock_trials_read_only(Y_trials):
    """P10f: marks every trial array read-only for the duration of a training
    run and returns a callable restoring the original flags. With the
    driver's own `_ValidatedTrials` snapshot of the trial references, this
    means an observation validated at the boundary cannot be silently
    changed afterwards through the array object that was validated (e.g. from
    a hook): in-place writes raise `ValueError`, and replacing a list element
    does not affect the snapshot. Writes through another alias of the same
    memory (a different view, or the base array) are not detectable this way."""
    changed = []
    seen = set()
    for Y in Y_trials:
        if isinstance(Y, np.ndarray) and id(Y) not in seen:
            seen.add(id(Y))
            if Y.flags.writeable:
                Y.flags.writeable = False
                changed.append(Y)

    def restore() -> None:
        for Y in changed:
            try:
                Y.flags.writeable = True
            except ValueError:  # its base was made read-only in the meantime; leave it read-only
                pass

    return restore


def _forward_only_loglik(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    fb_constants: FbConstants,
    *,
    backend: str,
    validate: str,
    n_jobs: int,
    executor: str | None,
    start_method: str | None = None,
) -> float:
    """Summed forward-only log-likelihood over `Y_trials` for `numpy`/`numba`.

    Equal, bit for bit, to `e_step(...).loglik` with the same arguments: every
    trial's value comes from the same forward recursion (`run_backend_loglik`),
    and trials are summed as a left fold from 0.0 in ORIGINAL trial order --
    the order `e_step`'s serial loop and its bounded parallel merge both use.
    Parallel execution reuses `_run_parallel_e_step`'s bounded in-flight
    scheduling and `TrialExecutionError` wrapping."""
    from chmm_lsim.backends.base import run_backend_loglik

    _validate_n_jobs_executor(n_jobs, executor, backend)
    n = len(Y_trials)
    if n == 0:
        raise ValueError("forward-only loglik requires at least one trial in Y_trials")
    validate = _runner_validate(structure, params, Y_trials, validate)
    total = 0.0
    if n_jobs == 1:
        for Y in Y_trials:
            total += run_backend_loglik(backend, fb_constants.variant, structure, params, Y, fb_constants, validate=validate)
        return total

    max_workers = min(n_jobs, n)
    max_in_flight = max_workers * _IN_FLIGHT_MULTIPLIER
    if executor == "thread":
        pool_cls = concurrent.futures.ThreadPoolExecutor
        pool_kwargs: dict = {}

        def _submit(pool, idx: int):
            return pool.submit(run_backend_loglik, backend, fb_constants.variant, structure, params, Y_trials[idx], fb_constants, validate=validate)
    else:
        pool_cls = concurrent.futures.ProcessPoolExecutor
        pool_kwargs = {"initializer": _process_loglik_worker_init, "initargs": (structure, params, fb_constants, backend, validate),
                       "mp_context": multiprocessing.get_context(_resolve_start_method(start_method, "process"))}

        def _submit(pool, idx: int):
            return pool.submit(_process_loglik_worker_run, Y_trials[idx])

    with pool_cls(max_workers=max_workers, **pool_kwargs) as pool:
        pending: deque = deque()
        next_to_submit = 0
        for _ in range(min(max_in_flight, n)):
            pending.append((next_to_submit, _submit(pool, next_to_submit)))
            next_to_submit += 1
        try:
            while pending:
                idx, fut = pending.popleft()
                try:
                    value = fut.result()
                except Exception as exc:  # noqa: BLE001 -- re-wrapped with the trial index, never swallowed
                    raise TrialExecutionError(idx, exc) from exc
                total += value
                if next_to_submit < n:
                    pending.append((next_to_submit, _submit(pool, next_to_submit)))
                    next_to_submit += 1
        except BaseException:
            for _, fut in pending:
                fut.cancel()
            raise
    return total


def _run_parallel_e_step(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    fb_constants: FbConstants,
    W: NDArray[np.float64],
    *,
    backend: str,
    validate: str,
    n_jobs: int,
    executor: str,
    start_method: str | None = None,
) -> ExpectedStats:
    """Runs one trial per task across a stdlib `ThreadPoolExecutor` or
    `ProcessPoolExecutor` (`_validate_n_jobs_executor` has already confirmed
    `executor` is one of these two), then merges every trial's own raw
    `ExpectedStats` into a running accumulator, in the trials' ORIGINAL
    `Y_trials` order -- never completion order, so the merged result (and
    therefore the fitted parameters downstream) does not depend on which
    worker happens to finish first, and repeated runs with the same inputs
    reproduce the same result.

    **Bounded in-flight scheduling (§P10b correction round).** At most
    `_IN_FLIGHT_MULTIPLIER * max_workers` trials are ever submitted-but-not-
    yet-merged at once: trials are submitted lazily, one more submitted each
    time the OLDEST still-outstanding one is retrieved and folded in, rather
    than submitting every one of `len(Y_trials)` up front and holding every
    `Future`/`ExpectedStats` until the very end. This is what makes this
    function usable at the intended ~100,000-trial scale: coordinator memory
    here is O(n_jobs), never O(len(Y_trials)) -- neither a list of every
    `Future` nor a list of every trial's own `ExpectedStats` is ever held at
    once (`tests/test_em_parallel.py`'s `test_bounded_in_flight_*` tests
    prove this directly, via an instrumented executor, as N grows).

    The merged result is IDENTICAL to submitting everything up front and
    merging once at the end, not merely close: `merge_expected_stats
    ([c0,...,cN-1])` already folds its chunks left-to-right internally
    (`_merge_field`'s own loop, and every top-level field's plain
    `sum(...)`), so incrementally calling `merge_expected_stats([running_
    merge, next_chunk])` one trial at a time performs the exact same
    sequence of arithmetic operations, in the exact same order, as one call
    over the whole list would -- this is a scheduling change, not a numeric
    one.

    A worker exception cancels every not-yet-STARTED trial and is re-raised
    as `TrialExecutionError`, naming the original (0-based) trial index --
    see that class's own docstring for exactly what does and doesn't finish
    running before this function returns."""
    n = len(Y_trials)
    max_workers = min(n_jobs, n)
    max_in_flight = max_workers * _IN_FLIGHT_MULTIPLIER

    if executor == "thread":
        pool_cls = concurrent.futures.ThreadPoolExecutor
        pool_kwargs: dict = {}

        def _submit(pool, idx: int):
            return pool.submit(_e_step_one_trial, structure, params, Y_trials[idx], fb_constants, W, backend=backend, validate=validate)
    else:
        pool_cls = concurrent.futures.ProcessPoolExecutor
        pool_kwargs = {"initializer": _process_worker_init, "initargs": (structure, params, fb_constants, W, backend, validate),
                       "mp_context": multiprocessing.get_context(_resolve_start_method(start_method, "process"))}

        def _submit(pool, idx: int):
            return pool.submit(_process_worker_run, Y_trials[idx])

    merged: ExpectedStats | None = None
    with pool_cls(max_workers=max_workers, **pool_kwargs) as pool:
        pending: deque = deque()  # (trial_index, Future) pairs, oldest-first -- never longer than max_in_flight
        next_to_submit = 0
        for _ in range(min(max_in_flight, n)):
            pending.append((next_to_submit, _submit(pool, next_to_submit)))
            next_to_submit += 1

        try:
            while pending:
                idx, fut = pending.popleft()
                try:
                    result = fut.result()
                except Exception as exc:  # noqa: BLE001 -- deliberately re-wrapped with the trial index below, never swallowed
                    raise TrialExecutionError(idx, exc) from exc
                merged = result if merged is None else merge_expected_stats([merged, result])
                del result  # folded in already -- drop the reference now, not at the end of an O(N) list

                if next_to_submit < n:
                    pending.append((next_to_submit, _submit(pool, next_to_submit)))
                    next_to_submit += 1
        except BaseException:
            for _, fut in pending:
                fut.cancel()
            raise

    return merged


def e_step(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    fb_constants: FbConstants | None = None,
    *,
    backend: str = "numpy",
    backend_options: dict | None = None,
    validate: str = "params",
    n_jobs: int = 1,
    executor: str | None = None,
    start_method: str | None = None,
) -> ExpectedStats:
    """Runs the E-step over `Y_trials` and returns *raw* (unfinalized)
    `ExpectedStats` -- call `finalize_expected_stats` (directly, or after
    `merge_expected_stats` with other chunks) before `m_step`. `backend`
    (default `"numpy"`) is passed through `backends.base.run_backend` for
    *every* trial -- `backend="numba"` genuinely runs the compiled kernels
    here, not just when calling `forward_backward` directly (there is no
    separate `get_inference(...)`-based bypass of the backend axis).

    `backend_options` (P8a) is a plain `dict` of backend-specific keyword
    arguments -- `device=`/`dtype=`/`chunk_size=`/`max_memory_bytes=`/
    `gz_form=` for `backend="torch"` -- deliberately *not* individual named
    parameters on this signature, so `e_step`'s own contract doesn't grow a
    new parameter for every backend this project ever adds. Only meaningful
    for `backend="torch"`; a non-empty `backend_options` for `"numpy"`/
    `"numba"` raises rather than being silently ignored (those backends
    have no options to receive it). `backend="torch"` calls
    `backends.torch_batched.forward_backward_batch(..., mode="stats")`
    **once**, over the whole `Y_trials` dataset -- not once per trial -- so
    the batched recursion genuinely runs batched during EM, not merely when
    `forward_backward`/`run_backend` is called directly.

    `n_jobs`/`executor` (P10b) apply only to the per-trial `numpy`/`numba`
    CPU paths below -- they control how the trials *within this one E-step*
    are evaluated (concurrently or not), never how many optimization
    updates happen (that is P10c's mini-batch driver's job, not this
    function's). `n_jobs=1` (the default) is the deterministic serial
    reference path, byte-for-byte unchanged from before P10b -- it does not
    go through `ProcessPoolExecutor`/`ThreadPoolExecutor` or
    `merge_expected_stats` at all. `n_jobs>1` requires an explicit
    `executor='thread'` or `executor='process'` (never inferred) and merges
    every trial's own raw stats in `Y_trials`' original order, never
    completion order -- see `_run_parallel_e_step`. `backend='torch'`
    requires `n_jobs=1`, `executor=None` (`_validate_n_jobs_executor`
    raises `UnsupportedCombination` otherwise): it already owns its own
    batch/device parallelism via `chunk_size`/`max_memory_bytes` above, an
    execution-memory control, never a trial-concurrency one -- stacking an
    outer CPU executor on top of it would duplicate the model, oversubscribe
    CPU threads, or create multiple CUDA contexts.

    **`executor='process'` requires the standard `multiprocessing` entry-
    point guard on spawn-based platforms** (the default start method on
    Windows always, and on macOS since Python 3.8 -- i.e. this project's own
    supported platforms): calling code that creates a `ProcessPoolExecutor`
    (directly, or indirectly through this `executor='process'` path) must
    live inside `if __name__ == "__main__":` (or otherwise be safely
    re-importable with no top-level side effects), because `spawn` starts
    each worker as a fresh interpreter that re-imports the launching
    script -- without the guard, that reimport can re-run the whole calling
    script in every worker, including recursively re-entering `e_step`
    itself. This is standard Python `multiprocessing`/`concurrent.futures`
    behavior, not specific to this function; every one of this file's own
    process-executor tests already runs under pytest's own entry point,
    which already satisfies this."""
    backend_options = backend_options or {}
    if backend != "torch" and backend_options:
        raise ValueError(
            f"backend_options={backend_options!r} was given but backend={backend!r} has no options to receive "
            f"it -- backend_options is only meaningful for backend='torch'"
        )
    _validate_n_jobs_executor(n_jobs, executor, backend)
    _resolve_start_method(start_method, executor)  # validate early (P10e)
    if fb_constants is None:
        fb_constants = FbConstants()

    if backend == "torch":
        from chmm_lsim.backends.torch_batched import forward_backward_batch

        return forward_backward_batch(
            structure, params, Y_trials, fb_constants, backend="torch", mode="stats", validate=validate, **backend_options
        )

    validate = _runner_validate(structure, params, Y_trials, validate)
    W = build_W(params.transition, params.coupling, structure.block_of_state)
    sigma_diag = params.sigma_diag

    if n_jobs > 1:
        if not Y_trials:
            raise ValueError("e_step requires at least one trial in Y_trials")
        return _run_parallel_e_step(
            structure, params, Y_trials, fb_constants, W, backend=backend, validate=validate, n_jobs=n_jobs, executor=executor,
            start_method=start_method,
        )

    channels = [
        _empty_channel_stats(
            structure.channel_state_num[c], structure.num_gmm_component[c], structure.channel_obs_dim[c], sigma_diag
        )
        for c in range(structure.C)
    ]
    zeta = np.zeros((structure.S, structure.S))
    gamma_first = np.zeros(structure.S)
    gamma_sum = np.zeros(structure.S)
    n_transitions = 0
    n_trials = 0
    T_all = 0
    loglik = 0.0

    for Y in Y_trials:
        post = run_backend(backend, fb_constants.variant, structure, params, Y, fb_constants, validate=validate)
        T = Y.shape[1]
        T_all += T
        n_trials += 1
        loglik += post.loglik
        gamma_first += post.gamma[:, 0]
        gamma_sum += post.gamma.sum(axis=1)
        if T > 1:
            abar = post.alpha[:, : T - 1] * post.scale[:, : T - 1]
            beta_next = post.beta[:, 1:]
            zeta += abar @ beta_next.T
            n_transitions += T - 1
        for c in range(structure.C):
            _accumulate_channel_trial(channels[c], structure, c, post, Y, sigma_diag)

    return ExpectedStats(
        zeta=zeta * W,
        gamma_first=gamma_first,
        gamma_sum=gamma_sum,
        n_trials=n_trials,
        n_transitions=n_transitions,
        T_all=T_all,
        loglik=loglik,
        channels=channels,
    )


def m_step(
    structure: LSIMStructure,
    stats: ExpectedStats,
    *,
    sigma_diag: bool,
    matlab_compat: bool = True,
    params_in: LSIMParams | None = None,
) -> LSIMParams:
    """`pi_0`/`transition`/`coupling`/every channel's emissions, from one
    (possibly mini-batch-scoped) finalized `ExpectedStats`.

    **Zero-transition mini-batches (P10c, §2.6).** `stats.n_transitions==0`
    (every trial in this E-step's own scope has `T=1`, e.g. a mini-batch
    drawn entirely from `T=1` trials) makes `transition`/`coupling`'s own
    defining formulas structurally undefined -- MATLAB's own `em_lsim_par.m`
    divides by its `L_T_1_batch=0` here, landing on `0/0=NaN` for the
    affected rows/columns, then its own NaN-replacement uniformly
    substitutes `1/M`/`1/C` -- silently manufacturing a UNIFORM structural
    parameter with no evidence behind it, which the design rules out
    ("must never... replace structural parameters with accidental uniform
    values merely because the batch contains no transition evidence").
    Python's policy is deliberately corrected, not reproduced: when `stats.
    n_transitions==0`, `transition`/`coupling` are copied UNCHANGED from
    `params_in` (required in that case -- raises `ValueError` if not given,
    rather than dividing by zero) instead of being recomputed at all; `pi_0`
    and every emission parameter are still updated normally, since both are
    well-defined from `gamma`/responsibilities alone, independent of
    transitions. Ordinary (`n_transitions>0`) callers are unaffected --
    `params_in` is optional and unused on that path, so this is not a
    behavior change for any existing caller."""
    if stats.gamma_p0 is None:
        raise ValueError("m_step requires finalized stats -- call finalize_expected_stats first")
    if stats.n_transitions == 0 and params_in is None:
        raise ValueError(
            "stats.n_transitions == 0 (every trial in this E-step's own scope has T=1) -- transition/coupling have "
            "no transition evidence to update from and must be preserved from the previous snapshot instead of "
            "dividing by zero; pass params_in= (P10c's zero-transition policy)"
        )
    S, C = structure.S, structure.C
    pi_0_new = stats.gamma_p0.copy()

    emissions_new: list[ChannelGMM] = [
        _gmm_m_step_channel(stats.channels[zee], T_all=stats.T_all, sigma_diag=sigma_diag, matlab_compat=matlab_compat)
        for zee in range(C)
    ]

    if stats.n_transitions == 0:
        if params_in.structure != structure:
            raise ValueError(
                "params_in.structure does not match the structure this m_step call is running under -- refusing to "
                "preserve transition/coupling from a different model's params_in (matching array shapes, e.g. same "
                "S and C with a different per-channel state partition, is not sufficient: the STATE MEANING differs)"
            )
        transition_new = params_in.transition.copy()
        coupling_new = params_in.coupling.copy()
    else:
        transition_new = np.zeros((S, S))
        coupling_new = np.zeros((C, C))
        for zee in range(C):
            zee_sl = structure.state_slice(zee)
            M_zee = structure.channel_state_num[zee]
            zeta_zee = stats.zeta[:, zee_sl]  # (S, M_zee)
            row_sums = zeta_zee.sum(axis=1)  # (S,)

            trans_zee = np.divide(zeta_zee, row_sums[:, None], out=np.full_like(zeta_zee, np.nan), where=row_sums[:, None] != 0)
            trans_zee = np.where(np.isnan(trans_zee), 1.0 / M_zee, trans_zee)
            transition_new[:, zee_sl] = trans_zee

            coupling_new[:, zee] = block_sum(row_sums, structure.state_offsets) / stats.n_transitions

        coupling_new = np.where(np.isnan(coupling_new), 1.0 / C, coupling_new)
        coupling_new = coupling_new / coupling_new.sum(axis=0, keepdims=True)

    return LSIMParams(structure=structure, pi_0=pi_0_new, transition=transition_new, coupling=coupling_new, emissions=emissions_new)


def repair_covariance(sig_temp: NDArray[np.float64], ridge_diag: NDArray[np.float64], *, matlab_compat: bool) -> NDArray[np.float64]:
    """§0.4.10 / quirk 10: `em_lsim.m:388`'s `if sum(eig(sig_temp)<=0)>1`
    repairs only when *at least two* eigenvalues are non-positive, leaving a
    singular or indefinite covariance in place when exactly one is --
    `matlab_compat=True` reproduces that threshold exactly; `matlab_compat=False`
    is the corrected `>0` (repairs on any non-positive eigenvalue). Symmetrizes
    first, matching `sig_temp = (sig_temp+sig_temp')/2` in the same line."""
    sig_temp = (sig_temp + sig_temp.T) / 2.0
    eigvals = np.linalg.eigvalsh(sig_temp)
    threshold = 1 if matlab_compat else 0
    if np.sum(eigvals <= 0) > threshold:
        sig_temp = sig_temp + np.diag(-eigvals.min() + ridge_diag)
    return sig_temp


def _fallback_univariate(cs: ChannelExpectedStats, *, matlab_compat: bool) -> tuple[NDArray, NDArray, NDArray]:
    """The `(W,mean,M2)` triple the fallback merges into the weighted one --
    the zero-filled all-`T_all` accumulator under canonical MATLAB
    (`matlab_compat=True`), or the observed-only accumulator under the
    corrected denominator (`matlab_compat=False`, quirk 1)."""
    if matlab_compat:
        return cs.allzero_n, cs.allzero_mean, cs.allzero_M2
    return cs.n_obs, cs.welford_mean, cs.welford_M2


def _gmm_m_step_channel(cs: ChannelExpectedStats, *, T_all: int, sigma_diag: bool, matlab_compat: bool) -> ChannelGMM:
    if cs.nanvar_y is None:
        raise ValueError("_gmm_m_step_channel requires finalized stats -- call finalize_expected_stats first")
    M_c, K_c = cs.resp.shape
    d_c = cs.n_obs.shape[0]

    weights = np.zeros((M_c, K_c))
    mu = np.zeros((d_c, M_c, K_c))
    sigma = np.zeros((d_c, M_c, K_c)) if sigma_diag else np.zeros((d_c, d_c, M_c, K_c))

    fb_W, fb_mean, fb_M2 = _fallback_univariate(cs, matlab_compat=matlab_compat)

    for i in range(M_c):
        for k in range(K_c):
            fb_mu = bool(cs.fallback_mu[i, k])

            if sigma_diag:
                W_ik, mean_ik, M2_ik = cs.weighted_W[i, k], cs.weighted_mean[i, k], cs.weighted_M2[i, k]
                if fb_mu:
                    _, mu_ik, M2_final = _welford_merge(W_ik, mean_ik, M2_ik, fb_W, fb_mean, fb_M2)
                else:
                    mu_ik, M2_final = mean_ik, M2_ik
                mu[:, i, k] = mu_ik
                sigma[:, i, k] = _SIGMA_RIDGE * cs.nanvar_y + M2_final / (W_ik + (fb_W if fb_mu else 0.0))
            else:
                Q, M, C = cs.pairwise_Q[i, k], cs.pairwise_M[i, k], cs.pairwise_C[i, k]
                W_diag, mean_diag, M2_diag = np.diag(Q), np.diag(M), np.diag(C)
                if fb_mu:
                    _, mu_ik, _ = _welford_merge(W_diag, mean_diag, M2_diag, fb_W, fb_mean, fb_M2)
                else:
                    mu_ik = mean_diag
                mu[:, i, k] = mu_ik

                fb_sigma = bool(cs.fallback_sigma_full[i, k])
                delta_i = M - mu_ik[:, None]
                delta_j = M.T - mu_ik[None, :]
                numerator = C + Q * delta_i * delta_j
                sigma_denom = cs.resp[i, k] + (T_all if fb_sigma else 0.0)
                if fb_sigma:
                    u_delta_i = cs.u_pairwise_M - mu_ik[:, None]
                    u_delta_j = cs.u_pairwise_M.T - mu_ik[None, :]
                    numerator = numerator + cs.u_pairwise_C + cs.u_pairwise_Q * u_delta_i * u_delta_j
                sig_temp = np.diag(_SIGMA_RIDGE * cs.nanvar_y) + numerator / sigma_denom
                sig_temp = repair_covariance(sig_temp, _SIGMA_RIDGE * cs.nanvar_y, matlab_compat=matlab_compat)
                sigma[:, :, i, k] = sig_temp

        resp_row = cs.resp[i, :]
        weights[i, :] = (resp_row + T_all * _EPS) / (np.sum(resp_row) + K_c * T_all * _EPS)

    return ChannelGMM(weights=weights, mu=mu, sigma=sigma, diag=sigma_diag)


def compute_aic_bic(structure: LSIMStructure, sigma_diag: bool, loglik: float, T_all: int) -> tuple[float, float]:
    C = structure.C
    M = np.array(structure.channel_state_num)
    K = np.array(structure.num_gmm_component)
    d = np.array(structure.channel_obs_dim)

    if sigma_diag:
        n_params = C * (C - 1) + int(M.sum()) ** 2 - C * int(M.sum()) + int(np.sum(M * K * 2 * d)) + int(np.sum(M * (K - 1)))
    else:
        n_params = C * (C - 1) + int(M.sum()) ** 2 - C * int(M.sum()) + int(np.sum(M * K * (d + d**2))) + int(np.sum(M * (K - 1)))

    aic = -2 * loglik + 2 * n_params
    bic = -2 * loglik + np.log(T_all) * n_params
    return float(aic), float(bic)


def apply_left2right_pi0_smoothing(pi_0: NDArray[np.float64], structure: LSIMStructure, left2right: bool) -> NDArray[np.float64]:
    """`em_lsim.m:159-164`'s one-time conversion of a raw `init_model.pi_0`
    into the *effective* `pi_0` iteration 1's E-step runs on: `pi_0 <-
    (1e-4+pi_0)/sum(...)` per channel block when `left2right` is falsy, or a
    plain per-block renormalisation (no additive smoothing) when it isn't."""
    out = np.zeros_like(pi_0)
    for c in range(structure.C):
        sl = structure.state_slice(c)
        block = pi_0[sl] if left2right else 1e-4 + pi_0[sl]
        out[sl] = block / block.sum()
    return out


@dataclass
class EmResult:
    params: LSIMParams  # best-iterate snapshot
    best_iterate: int  # 1-based iteration index the snapshot came from
    pi_steady: NDArray[np.float64] | None = None  # (S,) == gamma_sum/T_all at the best iterate (em_lsim.m's 8th output)
    loglik_trace: list[float] = field(default_factory=list)  # loglik_params_in per completed iteration
    aic_trace: list[float] = field(default_factory=list)
    bic_trace: list[float] = field(default_factory=list)
    n_iterations: int = 0


def _reject_float32_training(backend: str, backend_options: dict | None) -> None:
    """P10f: EM training on `backend="torch"` with `dtype="float32"` is
    explicitly unsupported (it previously failed later, inside the first
    post-update E-step, with a `pi_0` block-sum `ValidationError`).

    Measured on CUDA (`benchmarks/p8b/float32_training_gate_study.py`, 14
    cases x 10 epochs): float32 statistics leave M-step stochastic blocks off
    by up to ~1.2e-7 (the reproduced `pi_0` sum 0.99999998 failure), which a
    bounded float64 renormalization does repair -- but for `variant="sed"`
    float32 statistics are themselves wrong: the float32 SED backward
    recursion hits `beta_floor` thousands of times where float64 hits it a
    handful, corrupting `gamma` (single entries off by up to 1.0), and trained
    models diverge from float64 from the first updates (parameter differences
    up to 1.4 on the C=18, M=5 workload). `variant="fast"` stayed within
    ~1e-5 of float64 in the same study but is not approved on that evidence
    alone. Forward-only float32 scoring (`forward_backward_batch(mode=
    "loglik")`) is unaffected by this guard."""
    if backend == "torch" and (backend_options or {}).get("dtype", "float64") == "float32":
        raise UnsupportedCombination(
            "EM training with backend='torch', dtype='float32' is not supported: float32 statistics violate the "
            "M-step's stochastic invariants and, for variant='sed', corrupt the smoothed posteriors (beta_floor "
            "saturation in the float32 backward recursion). Train with backend_options={'dtype': 'float64'} (CUDA "
            "float64 is fast enough); float32 remains available for forward-only scoring."
        )


def em_lsim(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    *,
    max_iterations: int,
    fb_constants: FbConstants | None = None,
    backend: str = "numpy",
    backend_options: dict | None = None,
    matlab_compat: bool = True,
    check_convergence: bool = True,
    validate: str = "params",
    left2right: bool = False,
    raw_init_model: bool = False,
    iter_hook=None,
) -> EmResult:
    """`em_lsim.m`'s iteration loop. `params` is taken as already-effective by
    default; pass `raw_init_model=True` to have this apply
    `apply_left2right_pi0_smoothing` itself first (`em_lsim.m:159-164`, gated
    by `left2right`), matching `em_lsim.m`'s own `nargin==6` branch rather
    than requiring the caller to pre-smooth. `backend`/`backend_options`
    (default `"numpy"`/`None`) are forwarded to every iteration's `e_step`
    call unchanged -- see `e_step`'s own docstring for what `backend_options`
    is (a plain dict, not individual named parameters on this signature).
    `backend="torch"` with `dtype="float32"` raises `UnsupportedCombination`
    (P10f, see `_reject_float32_training`)."""
    _reject_float32_training(backend, backend_options)
    if fb_constants is None:
        fb_constants = FbConstants()
    if raw_init_model:
        params = params.copy()
        params.pi_0 = apply_left2right_pi0_smoothing(params.pi_0, structure, left2right)
    T_all = sum(Y.shape[1] for Y in Y_trials)
    sigma_diag = params.sigma_diag

    result = EmResult(params=params, best_iterate=0)
    best_loglik = -np.inf

    for itr in range(1, max_iterations + 1):
        raw_stats = e_step(structure, params, Y_trials, fb_constants, backend=backend, backend_options=backend_options, validate=validate)
        stats = finalize_expected_stats(raw_stats, sigma_diag=sigma_diag)
        aic, bic = compute_aic_bic(structure, sigma_diag, stats.loglik, T_all)
        params = m_step(structure, stats, sigma_diag=sigma_diag, matlab_compat=matlab_compat)
        pi_steady = stats.gamma_sum / stats.T_all

        result.loglik_trace.append(stats.loglik)
        result.aic_trace.append(aic)
        result.bic_trace.append(bic)
        result.n_iterations = itr

        if iter_hook is not None:
            iter_hook(itr, params, stats.loglik, aic, bic)

        # Convergence is checked BEFORE the best-iterate snapshot (em_lsim.m's
        # order): a `break` here skips this iteration's snapshot entirely, so
        # a converged run's best-iterate never considers the iteration that
        # triggered the break.
        if check_convergence and itr > 9:
            recent = np.diff(result.loglik_trace[itr - 6 : itr])
            if np.sum(recent < 0.001) >= 2:
                break

        if itr > 2:
            if stats.loglik > best_loglik:
                best_loglik = stats.loglik
                result.params = params
                result.pi_steady = pi_steady
                result.best_iterate = itr
        else:
            best_loglik = stats.loglik
            result.params = params
            result.pi_steady = pi_steady
            result.best_iterate = itr

    return result


# ==========================================================================
# P10c: backend-independent incremental mini-batch EM scheduling/update
# driver. Reuses P10b's `e_step` (and
# therefore its `n_jobs`/`executor` axis, and its `backend="torch"` ->
# `forward_backward_batch(..., mode="stats")` dispatch) unchanged for every
# mini-batch's own E-step -- this module adds only the SCHEDULING (which
# trials go in which mini-batch of which epoch) and the incremental UPDATE
# LOOP (freeze params_in, E-step, merge, finalize once, M-step, commit)
# around it. Deliberately NOT `em_lsim`/`EmResult`: no coherent end-of-epoch
# re-score, no `loglik_trace`/`aic_trace`/`bic_trace`, no convergence check,
# no best-iterate selection -- every one of those requires evaluating every
# trial under one single coherent parameter snapshot once per epoch, which
# is P10d's own job (§2.6), not this mechanical driver's.
# ==========================================================================


class _Unset:
    """A dedicated sentinel type, not `None` -- `em_lsim_minibatch`'s own
    `num_minibatches`/`shuffle`/`random_state` need to tell "the caller
    explicitly passed this" apart from "the caller left it at its default",
    which a plain default value can never do (an explicit `num_minibatches=1`
    is indistinguishable from omitting it if `1` is also the default) --
    see `em_lsim_minibatch`'s own docstring for why that distinction
    matters (schedule-generation-only controls given alongside an explicit
    `schedule=` must raise, not be silently ignored)."""

    __slots__ = ()

    def __repr__(self) -> str:
        return "<unset>"


_UNSET = _Unset()


def _canonical_trial_index(i) -> int:
    """A genuine, non-bool integer trial index, or raises. `bool` is a
    subclass of `int` in Python (`isinstance(True, int)` is `True`), so it
    is checked and rejected explicitly, before the general `int`/`np.
    integer` check would otherwise silently accept it as `0`/`1`; a `float`
    (even an integer-valued one like `0.0`) is rejected too -- both would
    otherwise pass a value-only range/membership check while being the
    wrong type."""
    if isinstance(i, bool):
        raise ValueError(f"trial index must be a plain int, got bool {i!r}")
    if isinstance(i, (int, np.integer)):
        return int(i)
    raise ValueError(f"trial index must be an int (or np.integer), got {type(i).__name__}: {i!r}")


@dataclass(frozen=True)
class MinibatchSchedule:
    """The exact, 0-based, ordered trial-index assignment for every mini-
    batch of every epoch in one P10c training run -- generated once up
    front (`generate_minibatch_schedule`) or supplied explicitly (e.g. to
    replay a P10a golden fixture's own MATLAB-exported schedule byte-for-
    byte via its `updates_trial_indices`/`updates_epoch_idx`/`updates_
    minibatch_idx` fields), so a run's own batch membership/order is fully
    reproducible and inspectable before any E-step ever executes it.

    `epochs[e][mb]` is a tuple of 0-based trial indices, in the exact order
    that mini-batch's own E-step will process them -- ordered, not merely a
    set: `em_lsim_par.m`'s own `batches{mb}` is `perm(edges(b)+1:edges(b+1))`,
    an ordered slice of that epoch's `randperm` output, not a resorted one,
    and P10a's fixture replay depends on that order being preserved exactly.

    **Deep canonicalization at construction (§P10c correction round).**
    `epochs` (and every nested epoch/mini-batch) is converted to a genuine
    tuple regardless of what was passed in (a list of lists is accepted and
    converted, not merely tolerated by duck-typing) -- a `frozen=True`
    dataclass only freezes its own top-level field *assignment*; it does
    nothing to prevent a caller's own mutable nested `list` from being
    mutated later out from under an already-constructed, supposedly-
    immutable schedule. Every trial index is independently canonicalized to
    a plain `int` (`_canonical_trial_index`): a `bool` is rejected outright
    (`isinstance(True, int)` is `True` in Python, so `0 <= False < num_
    trials` silently reads as a valid index `0` unless bool is excluded
    explicitly), and a `float` such as `0.0` is rejected even though it
    compares equal to the int `0` -- both would otherwise pass a value-only
    range/membership check while being the wrong TYPE. This construction-
    time canonicalization means `validate_minibatch_schedule` never needs
    to re-check index types -- only index VALUES -- for any `MinibatchSchedule`
    instance that already exists."""

    epochs: tuple[tuple[tuple[int, ...], ...], ...]

    def __post_init__(self) -> None:
        canonical = tuple(
            tuple(tuple(_canonical_trial_index(i) for i in mb) for mb in epoch) for epoch in self.epochs
        )
        object.__setattr__(self, "epochs", canonical)

    @property
    def max_iterations(self) -> int:
        return len(self.epochs)

    @property
    def num_minibatches(self) -> int:
        """The per-epoch mini-batch count -- GUARANTEED constant across
        every epoch for any schedule that has passed `validate_minibatch_
        schedule` (§P10c correction round: a varying per-epoch count now
        raises there, rather than being silently summarized by only the
        first epoch's own count). `em_lsim_minibatch` always validates
        before use, so this is safe to rely on for any schedule it actually
        runs; a schedule built and inspected WITHOUT validation first could
        still have a varying count, in which case this reports only the
        first epoch's own -- construct-then-validate (or use `generate_
        minibatch_schedule`, which validates its own result) if that
        matters to a caller."""
        return len(self.epochs[0]) if self.epochs else 0


def validate_minibatch_schedule(schedule: MinibatchSchedule, *, num_trials: int, max_iterations: int | None = None) -> None:
    """Raises `ValueError`, naming the exact problem, for any schedule that
    does not partition `range(num_trials)` exactly once per epoch: wrong
    epoch count (only checked if `max_iterations` is given), a mini-batch
    count that varies epoch to epoch (§P10c correction round: this is what
    makes `MinibatchSchedule.num_minibatches`'s single-number summary
    meaningful -- a schedule that fails this check is still representable
    as a `MinibatchSchedule`, just rejected here rather than silently
    misreported by that property), an out-of-range or negative 0-based
    index, a trial missing or duplicated within an epoch, or an empty
    mini-batch. Trial-index TYPE correctness (no bool/float indices) is
    `MinibatchSchedule.__post_init__`'s own job, not this function's --
    by the time an instance exists, its indices are already genuine `int`.

    **Its own arguments are validated too (§P10c final correction round).**
    `schedule` must genuinely be a `MinibatchSchedule` (not, say, a plain
    list of lists that happens to look like one -- `len(schedule.epochs)`
    below would raise a confusing `AttributeError` otherwise); `num_trials`
    must be a positive, non-bool int; `max_iterations`, when given, must be
    a positive, non-bool int too. The last one matters concretely: with a
    genuine one-epoch schedule, `len(schedule.epochs) != max_iterations`
    alone would silently ACCEPT `max_iterations=True` or `max_iterations=
    1.0` (both compare equal to the int `1` in Python), which is exactly
    the same bool/float-masquerading-as-int problem `_canonical_trial_
    index` already guards against for trial indices -- now guarded here
    for `max_iterations`/`num_trials` too."""
    if not isinstance(schedule, MinibatchSchedule):
        raise ValueError(f"schedule must be a MinibatchSchedule, got {type(schedule).__name__}: {schedule!r}")
    num_trials = _require_positive_int(num_trials, "num_trials")
    if max_iterations is not None:
        max_iterations = _require_positive_int(max_iterations, "max_iterations")
    if max_iterations is not None and len(schedule.epochs) != max_iterations:
        raise ValueError(f"schedule has {len(schedule.epochs)} epochs, expected max_iterations={max_iterations}")
    if not schedule.epochs:
        raise ValueError("schedule has zero epochs")
    minibatch_counts = {len(mbs) for mbs in schedule.epochs}
    if len(minibatch_counts) > 1:
        raise ValueError(
            f"schedule's own mini-batch count varies across epochs ({sorted(minibatch_counts)}) -- every epoch must "
            f"have the same number of mini-batches"
        )
    for e, mbs in enumerate(schedule.epochs):
        if not mbs:
            raise ValueError(f"epoch {e}: schedule has zero mini-batches")
        seen: list[int] = []
        for mb, idx in enumerate(mbs):
            if not idx:
                raise ValueError(f"epoch {e}, minibatch {mb}: empty mini-batch")
            for i in idx:
                if not (0 <= i < num_trials):
                    raise ValueError(f"epoch {e}, minibatch {mb}: trial index {i} out of range [0, {num_trials})")
            seen.extend(idx)
        if len(seen) != num_trials or sorted(seen) != list(range(num_trials)):
            counts: dict[int, int] = {}
            for i in seen:
                counts[i] = counts.get(i, 0) + 1
            duplicates = sorted(i for i, c in counts.items() if c > 1)
            missing = sorted(set(range(num_trials)) - set(seen))
            raise ValueError(
                f"epoch {e}: does not partition every trial in range(0,{num_trials}) exactly once "
                f"(duplicates={duplicates}, missing={missing})"
            )


def _resolve_num_minibatches(num_minibatches: int, num_trials: int) -> int:
    """`em_lsim_par.m`'s own policy exactly: `mini_batch > num_trails`
    warns and clamps to `num_trails` (`round(extra.mini_batch)` there is
    MATLAB's own int-rounding of a possibly-non-integer input; Python's
    caller is expected to already pass a genuine int, so this only clamps,
    it does not round)."""
    num_minibatches = _require_positive_int(num_minibatches, "num_minibatches")
    if num_minibatches > num_trials:
        warnings.warn(
            f"num_minibatches ({num_minibatches}) > number of trials ({num_trials}); clamping to {num_trials} "
            f"(matches em_lsim_par.m's own mini_batch>num_trails warning+clamp policy)",
            stacklevel=3,
        )
        return num_trials
    return int(num_minibatches)


def _resolve_rng(random_state: int | np.random.Generator | None) -> np.random.Generator:
    """Never touches NumPy's global random state (`np.random.seed`/the
    legacy global `RandomState`) -- an explicit `np.random.Generator`,
    either passed in directly or freshly constructed via `np.random.
    default_rng(random_state)` (which itself never reads or writes global
    state), is the only source of randomness this whole module ever uses.

    **Strictly typed (§P10c final correction round).** Accepts only `None`
    (fresh, still-non-global entropy), a genuine non-bool `int`/`np.integer`
    seed, or an already-constructed `np.random.Generator` -- `bool` (a
    subclass of `int` in Python, so `True`/`False` would otherwise silently
    seed with `1`/`0`), `float`, `str`, a legacy `np.random.RandomState`
    (NOT a `Generator`, and not usable as this module's own RNG), and any
    other type all raise a clear `ValueError` naming the actual type given,
    rather than being handed to `np.random.default_rng` and failing (or, for
    some inputs, silently "succeeding") with an unrelated, confusing NumPy-
    internal error."""
    if random_state is None:
        return np.random.default_rng(None)
    if isinstance(random_state, np.random.Generator):
        return random_state
    if isinstance(random_state, bool) or not isinstance(random_state, (int, np.integer)):
        raise ValueError(
            f"random_state must be None, a non-bool int seed, or an np.random.Generator, got "
            f"{type(random_state).__name__}: {random_state!r}"
        )
    return np.random.default_rng(int(random_state))


def _require_positive_int(value, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, (int, np.integer)) or value < 1:
        raise ValueError(f"{name} must be a positive int, got {value!r}")
    return int(value)


def generate_minibatch_schedule(
    num_trials: int, max_iterations: int, num_minibatches: int, *, shuffle: bool, rng: np.random.Generator
) -> MinibatchSchedule:
    """Mirrors `em_lsim_par.m`'s own per-epoch partitioning exactly --
    `edges = round(linspace(0, num_trials, num_minibatches+1))`, then
    `perm(edges(b)+1:edges(b+1))` per mini-batch -- matching MATLAB's own
    partition-SIZE behavior for an uneven split (`num_trials` not evenly
    divisible by `num_minibatches`).

    **MATLAB-compatible rounding, not NumPy's default (§P10c correction
    round).** MATLAB's `round` breaks ties away from zero (`round(2.5)==3`);
    `np.round` breaks ties to EVEN (`np.round(2.5)==2`, banker's rounding) --
    a real, measured divergence, not a theoretical one: `num_trials=5,
    num_minibatches=2` gives MATLAB edges `[0,3,5]` but `np.round` its own
    `edges=[0,2,5]`, a different (`3,2`) vs (`2,3`) mini-batch-size split for
    the exact same inputs. Every edge here is non-negative, so half-away-
    from-zero is exactly `floor(x+0.5)`, computed directly rather than via
    `np.round` at all.

    This does NOT reproduce MATLAB's own `randperm` SEQUENCE for a shared
    seed (`np.random.Generator.permutation` and MATLAB `randperm` are
    different algorithms) -- that is what the explicit `schedule=` override
    on `em_lsim_minibatch` exists for; this generator is for genuine
    Python-side training, not fixture replay.

    Validates every argument itself (never trusts a caller-supplied
    pre-check) and validates its OWN result via `validate_minibatch_
    schedule` before returning -- this function must never hand back an
    invalid schedule. `num_minibatches > num_trials` must already have been
    resolved by the caller (`_resolve_num_minibatches`) -- this raises
    rather than silently clamping again."""
    num_trials = _require_positive_int(num_trials, "num_trials")
    max_iterations = _require_positive_int(max_iterations, "max_iterations")
    num_minibatches = _require_positive_int(num_minibatches, "num_minibatches")
    if not isinstance(shuffle, (bool, np.bool_)):
        raise ValueError(f"shuffle must be a bool, got {shuffle!r}")
    if not isinstance(rng, np.random.Generator):
        raise ValueError(f"rng must be a np.random.Generator, got {type(rng).__name__}: {rng!r}")
    if num_minibatches > num_trials:
        raise ValueError(f"num_minibatches={num_minibatches} > num_trials={num_trials} -- caller must resolve/clamp first")

    edges = np.floor(np.linspace(0, num_trials, num_minibatches + 1) + 0.5).astype(int)
    epochs = []
    for _ in range(max_iterations):
        perm = rng.permutation(num_trials) if shuffle else np.arange(num_trials)
        mbs = tuple(tuple(int(i) for i in perm[edges[b] : edges[b + 1]]) for b in range(num_minibatches))
        epochs.append(mbs)
    schedule = MinibatchSchedule(epochs=tuple(epochs))
    validate_minibatch_schedule(schedule, num_trials=num_trials, max_iterations=max_iterations)
    return schedule


def compute_global_nanvar(
    structure: LSIMStructure, Y_trials: list[NDArray[np.float64]], *, max_chunk_observations: int | None = None
) -> list[NDArray[np.float64]]:
    """Precomputes each channel's whole-dataset observed-only `nanvar_y` --
    the canonical MATLAB mini-batch covariance-ridge policy (P10c, §2.6).
    `em_lsim_par.m`'s own covariance ridge (`0.001*var(...)`, §0.4.1) reads
    `all_observation` -- the WHOLE dataset's concatenated observations,
    built once outside the mini-batch loop (`em_lsim_par.m:169`) -- even
    though every OTHER M-step quantity for that same update (`Recentering`,
    `weight_update`, the responsibility-weighted mean) reads
    `all_observation_batch`, the CURRENT mini-batch's own subset
    (`em_lsim_par.m:394-401`, consumed at `:511`/`:517`/`:520`; contrast the
    ridge itself at `:508`/`:517`/`:520`, which reads `all_observation`, not
    `all_observation_batch`) -- confirmed by reading `em_lsim_par.m`
    directly during the P10b correction round, not guessed.

    **No inference (§P10c correction round).** `nanvar_y` depends only on
    which values were OBSERVED (`Y`/`structure`), never on `params`/`gamma`
    at all -- the first version of this function nonetheless ran one
    complete whole-dataset forward-backward E-step (`e_step`, discarding
    every gamma-dependent field it computed) just to reach `finalize_
    expected_stats`'s own `nanvar_y` formula, which is real, unnecessary
    inference work: a full pass over every trial, potentially spawning its
    own `ProcessPoolExecutor` or an extra Torch batched pass, directly
    undermining the ~100,000-trial scalability goal this whole phase exists
    for. This version accumulates the SAME per-channel observed-only
    Welford state (`_welford_batch`/`_welford_merge`, the exact functions
    `_accumulate_channel_trial`'s own `n_obs`/`welford_mean`/`welford_M2`
    fields use) directly from `Y_trials`, with NO `params`, `FbConstants`,
    `backend`, `n_jobs`, `executor`, or `backend_options` needed at all --
    and applies the shared `_nanvar_from_welford` formula (MATLAB sample
    variance, `ddof=1`; `n_obs==1 -> 0.0`, not `NaN`; `n_obs==0 -> NaN`;
    numerically stable at large offsets, since Welford's algorithm never
    forms a raw `sum(y**2)` moment). Accumulator memory is O(model
    dimensions) -- one `(d_c,)` triple per channel, reused across every
    trial -- never O(len(Y_trials)) or O(T_all).

    Must be computed exactly ONCE, before mini-batch training begins, and
    never recomputed from an individual mini-batch's own subset --
    `em_lsim_minibatch` calls this once and substitutes the result into
    every mini-batch's own finalized stats via `_substitute_global_nanvar`,
    before every `m_step` call.

    **Validates every trial before touching it (§P10c final correction).**
    This function runs before the very first E-step of a training run, so
    it is the first place a malformed `Y_trials` would otherwise be
    discovered ONLY by an obscure downstream symptom rather than a clear
    error here: a scalar or 1-D `Y` would raise a raw, confusing indexing
    error from `Y[dim_sl, :]`; a wrong-`D` array would be sliced against
    the wrong dimension boundaries and silently produce a wrong (not
    obviously wrong) `nanvar_y`; an integer-dtype `Y` would silently violate
    this package's floating-observation contract (`§2.1.1`); `+/-Inf` would
    silently produce `NaN`/`Inf` variance rather than a caught error;
    `T=0` would silently contribute nothing. `validate_observations`
    (already this package's own single source of truth for exactly these
    checks -- shape, dtype, `D`, `T>=1`, no `Inf`) is called on every trial
    before any accumulation begins, re-raising with that trial's own
    position in `Y_trials` named, so a large (e.g. ~100,000-trial) dataset's
    one bad trial is immediately identifiable. Legal `NaN` missingness is
    untouched -- `validate_observations` itself only rejects `Inf`, never
    `NaN`. An empty `Y_trials` is rejected outright (there is no such thing
    as a whole-dataset variance of zero trials -- silently returning
    all-`NaN` would be a `nanvar_y` for a dataset that doesn't exist).

    **Chunk-vectorized (P10f).** The previous body validated every trial with
    a Python-level `validate_observations` call and then merged one Welford
    batch per trial per channel -- a per-trial Python loop that dominated
    CUDA training at large N (~8 s per 20,000 trials; ~600 s of a 631 s
    two-epoch run at N=1,000,000). Now `validate.
    _iter_validated_observation_chunks` validates bounded chunks of trials
    (at most `max_chunk_observations` values, default `validate.DEFAULT_MAX_
    CHUNK_OBSERVATIONS`; a single larger trial forms its own chunk) with the
    identical checks, messages and error order, and each validated chunk is
    folded into the same float64 observed-only Welford/Chan accumulators by
    one `_welford_batch` over the chunk's concatenated timesteps followed by
    `_welford_merge` -- the same mergeable central-moment semantics, never the
    whole dataset concatenated, and no observation reaches an accumulator
    before its chunk passed validation. `n_obs==0 -> NaN`, `n_obs==1 -> 0.0`
    and ragged/missing handling are unchanged (`_nanvar_from_welford`)."""
    if not Y_trials:
        raise ValueError("Y_trials must contain at least one trial")
    accumulators = [
        (np.zeros(structure.channel_obs_dim[c]), np.zeros(structure.channel_obs_dim[c]), np.zeros(structure.channel_obs_dim[c]))
        for c in range(structure.C)
    ]
    for _start, _stop, X, nan_mask in _iter_validated_observation_chunks(
        structure, Y_trials, label="Y_trials", max_chunk_observations=max_chunk_observations
    ):
        for c in range(structure.C):
            dim_sl = structure.dim_slice(c)
            o = ~nan_mask[dim_sl, :]
            X_c = X[dim_sl, :]
            # Center each dimension on one of its own observed values before the chunk-wide sum (exact algebra:
            # the mean shifts back, the central moment M2 is shift-invariant), so a chunk of thousands of
            # large-offset values does not lose the precision the per-trial merge kept.
            has_obs = o.any(axis=1)
            shift = np.where(has_obs, X_c[np.arange(X_c.shape[0]), o.argmax(axis=1)], 0.0)
            obs_W, obs_mean, obs_M2 = _welford_batch(o.astype(np.float64), np.where(o, X_c - shift[:, None], 0.0))
            obs_mean = np.where(obs_W > 0, obs_mean + shift, 0.0)
            accumulators[c] = _welford_merge(*accumulators[c], obs_W, obs_mean, obs_M2)
    return [_nanvar_from_welford(n_obs, welford_M2) for n_obs, _mean, welford_M2 in accumulators]


def _substitute_global_nanvar(stats: ExpectedStats, global_nanvar: list[NDArray[np.float64]]) -> ExpectedStats:
    """Overrides each channel's own derived `nanvar_y` (computed by
    `finalize_expected_stats` from THIS mini-batch's own accumulators) with
    the precomputed, immutable whole-dataset value from `compute_global_
    nanvar` -- `stats` must already be finalized (so `nanvar_y` is non-None
    and about to be overwritten, not left uncomputed)."""
    if any(c.nanvar_y is None for c in stats.channels):
        raise ValueError("_substitute_global_nanvar requires already-finalized stats")
    return dataclasses_replace(
        stats, channels=[dataclasses_replace(c, nanvar_y=global_nanvar[i]) for i, c in enumerate(stats.channels)]
    )


@dataclass
class MinibatchUpdate:
    """One optimization mini-batch's own complete trace record -- the
    Python-object counterpart of everything P10a's own fixture `updates_*`
    fields capture. `training_batch_loglik` is explicitly diagnostic (§2.6):
    it is this mini-batch's own trials' log-likelihood measured under
    `params_in` (the PRE-update snapshot) -- never pair it with `params_out`,
    and never confuse it with a coherent, single-model log-likelihood (that
    is P10d's own end-of-epoch re-score, not this)."""

    epoch_idx: int  # 1-based, matching P10a's own convention
    minibatch_idx: int  # 1-based
    trial_indices: tuple[int, ...]  # 0-based, into the Y_trials list given to em_lsim_minibatch, in E-step order
    params_in: LSIMParams
    params_out: LSIMParams
    n_trials: int
    T_all: int
    n_transitions: int
    training_batch_loglik: float


@dataclass
class MinibatchEmResult:
    """P10c's own driver result -- deliberately NOT `EmResult`: no
    `loglik_trace`/`aic_trace`/`bic_trace`, no `pi_steady`, no best-iterate,
    no convergence decision. Every one of those requires evaluating every
    trial under ONE single coherent parameter snapshot once per epoch --
    P10d's own end-of-epoch re-score (§2.6) -- which this mechanical
    scheduling/update driver does not compute. `params` is simply the LAST
    committed snapshot (the final mini-batch's own `params_out`), not a
    "best" one, since nothing here evaluates a coherent metric to select a
    best iterate by."""

    params: LSIMParams  # final committed snapshot, after the schedule's very last mini-batch update
    schedule: MinibatchSchedule
    updates: list[MinibatchUpdate] = field(default_factory=list)

    @property
    def training_batch_loglik_by_epoch(self) -> list[float]:
        """Per-epoch sum of `training_batch_loglik` across that epoch's own
        mini-batches -- ONE value per epoch, the direct analogue of
        `em_lsim_par.m`'s own per-epoch `epoch_P_O_model` sum (§2.6's "mixed
        pre-update mini-batch likelihood" diagnostic). **Named correction,
        §P10c correction round**: a prior version of this class exposed only
        `training_batch_loglik_sum` (the sum across EVERY epoch in the whole
        run) while its own docstring called it the analogue of MATLAB's
        PER-EPOCH `epoch_P_O_model` -- a real mismatch between the name/
        value and the claimed semantics. This property is the one that is
        actually per-epoch. Still a mixed-parameter diagnostic, not a
        coherent single-model log-likelihood (every mini-batch within an
        epoch scored its own trials under a DIFFERENT, successively-updated
        `params_in` snapshot) -- never use this, or `training_batch_loglik_
        total` below, for convergence or best-iterate selection (P10d's own
        job, not this mechanical driver's)."""
        by_epoch: dict[int, float] = {}
        for u in self.updates:
            by_epoch[u.epoch_idx] = by_epoch.get(u.epoch_idx, 0.0) + u.training_batch_loglik
        return [by_epoch[e] for e in sorted(by_epoch)]

    @property
    def training_batch_loglik_total(self) -> float:
        """Sum of `training_batch_loglik_by_epoch` across the WHOLE run --
        explicitly the whole-run total, not a per-epoch value (replaces the
        prior, ambiguously-named `training_batch_loglik_sum`). Same caveats
        as `training_batch_loglik_by_epoch`: a mixed-parameter diagnostic,
        never a coherent single-model log-likelihood, never used for
        convergence or best-iterate selection."""
        return sum(u.training_batch_loglik for u in self.updates)


def _resolve_schedule(
    Y_trials: list[NDArray[np.float64]],
    *,
    max_iterations: int | None,
    num_minibatches,
    shuffle,
    random_state,
    schedule: MinibatchSchedule | None,
) -> MinibatchSchedule:
    """Resolves/validates one `MinibatchSchedule`, shared by `em_lsim_
    minibatch` and `em_lsim_minibatch_train` -- factored out (§P10c/P10d
    correction round) so this logic exists in exactly one place, never
    reimplemented (and never independently re-broken) in either caller.

    An earlier version of both callers reimplemented this branch
    separately and both reintroduced two already-fixed bugs: accessing
    `schedule.epochs` (via `len(schedule.epochs)`) before confirming
    `schedule` is actually a `MinibatchSchedule` (a non-`MinibatchSchedule`
    `schedule=` would raise a confusing `AttributeError` instead of a
    clear `ValueError`), and comparing `max_iterations` to that length with
    a bare `!=`, which `True`/`1.0` can silently pass (both compare equal
    to the int `1` in Python) exactly like the bool/float-masquerading-as-
    int problem `_canonical_trial_index`/`_require_positive_int` already
    guard against elsewhere. Both are fixed here by routing EVERY explicit-
    schedule call through `validate_minibatch_schedule(schedule, num_trials=
    ..., max_iterations=max_iterations)` -- which already performs both
    checks, strictly, before touching `schedule.epochs` at all -- instead
    of a separate, ad hoc pre-check in the caller."""
    num_trials = len(Y_trials)
    if schedule is not None:
        conflicting = [
            name
            for name, val in (("num_minibatches", num_minibatches), ("shuffle", shuffle), ("random_state", random_state))
            if val is not _UNSET
        ]
        if conflicting:
            raise ValueError(
                f"schedule= was given together with {conflicting} -- these control schedule GENERATION and would "
                f"be silently ignored (not merely inapplicable) when an explicit schedule is supplied instead; "
                f"drop them, or drop schedule= and let this function generate one"
            )
        validate_minibatch_schedule(schedule, num_trials=num_trials, max_iterations=max_iterations)
        return schedule

    if max_iterations is None:
        raise ValueError("max_iterations is required when no explicit schedule is given")
    resolved_num_minibatches = _resolve_num_minibatches(1 if num_minibatches is _UNSET else num_minibatches, num_trials)
    resolved_shuffle = True if shuffle is _UNSET else shuffle
    resolved_random_state = None if random_state is _UNSET else random_state
    rng = _resolve_rng(resolved_random_state)
    # generate_minibatch_schedule already validates its own result before
    # returning (§P10c correction round) -- no need to re-validate here.
    return generate_minibatch_schedule(num_trials, max_iterations, resolved_num_minibatches, shuffle=resolved_shuffle, rng=rng)


def _run_one_minibatch_update(
    structure: LSIMStructure,
    params_in: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    trial_indices: tuple[int, ...],
    epoch_idx: int,
    minibatch_idx: int,
    fb_constants: FbConstants,
    global_nanvar: list[NDArray[np.float64]],
    *,
    backend: str,
    backend_options: dict | None,
    n_jobs: int,
    executor: str | None,
    matlab_compat: bool,
    validate: str,
    start_method: str | None = None,
) -> MinibatchUpdate:
    """One mini-batch's own complete E-step -> finalize -> global-`nanvar`-
    substitute -> M-step -> commit, given an ALREADY-COMPUTED `global_
    nanvar` (§P10c/P10d correction round: factored out of `em_lsim_
    minibatch`'s own loop body specifically so that neither it nor
    `em_lsim_minibatch_train` ever calls `compute_global_nanvar` more than
    ONCE per training run -- see both callers' own docstrings for why
    calling it once per epoch, as an earlier version of `em_lsim_minibatch_
    train` did, is a real scalability defect at the ~100,000-trial scale
    this whole phase targets, not merely an inefficiency). `params_in` is
    never mutated -- returned unchanged as `MinibatchUpdate.params_in`, safe
    to hold a reference to.

    Worker-exception trial indices are translated from LOCAL (`e_step`'s
    own `TrialExecutionError.trial_index`, an index into `trial_indices`
    itself) to GLOBAL (an index into the full `Y_trials` list) here -- the
    single place this translation needs to happen for either caller, so a
    caller debugging a large run learns which of ALL its trials failed,
    never merely which position within one mini-batch."""
    batch_Y = Y_trials.subset(trial_indices) if isinstance(Y_trials, _ValidatedTrials) else [Y_trials[i] for i in trial_indices]
    sigma_diag = params_in.sigma_diag

    try:
        raw = e_step(
            structure, params_in, batch_Y, fb_constants,
            backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor, validate=validate,
            start_method=start_method,
        )
    except TrialExecutionError as exc:
        global_index = trial_indices[exc.trial_index]
        raise TrialExecutionError(global_index, exc.original_exception) from exc.original_exception

    training_batch_loglik = raw.loglik
    stats = finalize_expected_stats(raw, sigma_diag=sigma_diag)
    stats = _substitute_global_nanvar(stats, global_nanvar)
    params_out = m_step(structure, stats, sigma_diag=sigma_diag, matlab_compat=matlab_compat, params_in=params_in)

    return MinibatchUpdate(
        epoch_idx=epoch_idx,
        minibatch_idx=minibatch_idx,
        trial_indices=trial_indices,
        params_in=params_in,
        params_out=params_out,
        n_trials=stats.n_trials,
        T_all=stats.T_all,
        n_transitions=stats.n_transitions,
        training_batch_loglik=training_batch_loglik,
    )


def em_lsim_minibatch(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    *,
    max_iterations: int | None = None,
    num_minibatches: int | _Unset = _UNSET,
    shuffle: bool | _Unset = _UNSET,
    random_state: int | np.random.Generator | None | _Unset = _UNSET,
    schedule: MinibatchSchedule | None = None,
    fb_constants: FbConstants | None = None,
    backend: str = "numpy",
    backend_options: dict | None = None,
    n_jobs: int = 1,
    executor: str | None = None,
    matlab_compat: bool = True,
    validate: str = "params",
    left2right: bool = False,
    raw_init_model: bool = False,
    start_method: str | None = None,
) -> MinibatchEmResult:
    """P10c's own incremental mini-batch EM scheduling/update driver
    -- backend-independent (reuses `e_step`
    unchanged for `numpy`/`numba`/`torch`, so P10b's `n_jobs`/`executor` axis
    and Torch's `chunk_size`/`max_memory_bytes` execution-memory controls
    apply exactly as documented there).

    **Two independent controls, never conflated** (§2.6): `num_minibatches`
    is a COUNT of disjoint mini-batches per epoch (never a batch size, and
    never Torch's own `chunk_size`); `n_jobs`/`executor`/`backend_options`
    control only how the trials WITHIN one mini-batch's own E-step are
    evaluated. `num_minibatches=1` reduces every epoch to one mini-batch
    containing every trial -- algebraically the same E-step/M-step `em_lsim`
    itself performs each iteration, and (with `shuffle=False`,
    `backend='numpy'`, `n_jobs=1`) numerically byte-identical PER ITERATION
    to the exact `params_out` `em_lsim`'s own E-step/M-step call produces at
    that iteration (confirmed against every intermediate iteration via
    `em_lsim`'s own `iter_hook`, not merely the last one) -- the exact same
    `e_step`/`m_step` calls run over the exact same trial order, so the
    UPDATE SEQUENCE matches exactly. **This is a narrower guarantee than
    "reproduces `em_lsim`'s own returned `EmResult`"** (§P10c correction
    round: an earlier version of this docstring overclaimed the broader
    one): `em_lsim`'s own `EmResult.params` is a BEST-ITERATE snapshot,
    which can be an EARLIER iteration than the last one, and `em_lsim` can
    stop early via its own convergence check -- neither best-iterate
    selection nor convergence exists in this driver at all (P10d's job).
    `em_lsim_minibatch`'s own `MinibatchEmResult.params` is always the LAST
    committed update's `params_out`, which only equals `em_lsim`'s own
    returned best-iterate params when the run happens to converge on (or
    never improve past) its final iteration.

    **Scheduling.** Either pass `schedule=` directly (an already-validated
    or independently-constructed `MinibatchSchedule` -- e.g. reconstructed
    from a P10a golden fixture's own `updates_trial_indices`/`updates_epoch_
    idx`/`updates_minibatch_idx`, for exact replay) or let this generate one
    via `generate_minibatch_schedule`, seeded by an explicit
    `np.random.Generator` (`random_state` -- an int seed, an existing
    `Generator`, or `None` for fresh, still-non-global entropy) -- this
    module never reads or writes NumPy's global random state.
    `num_minibatches > len(Y_trials)` warns and clamps to `len(Y_trials)`
    (`_resolve_num_minibatches`, matching `em_lsim_par.m`'s own policy).
    Every schedule -- generated or given -- is validated (`validate_
    minibatch_schedule`) before any E-step runs: exact epoch count (only
    when generating, since `max_iterations` is otherwise inferred FROM the
    given schedule), 0-based in-range indices, and every trial exactly once
    per epoch, no duplicates or drops, no empty mini-batches.

    **Per-mini-batch update (§2.6's own raw/merge/finalize contract)**: for
    each mini-batch, in schedule order, `params_in` is the CURRENT (already-
    committed) snapshot -- nothing here mutates it in place, so holding a
    reference to it in the returned trace is safe, not merely "frozen" by
    convention. One raw E-step runs over that mini-batch's own trials
    (`e_step`, reused unchanged from P10b/P8a); its raw `ExpectedStats` is
    finalized exactly once, has this run's precomputed global `nanvar_y`
    substituted in (`compute_global_nanvar`/`_substitute_global_nanvar`,
    §2.6's own covariance-ridge policy -- see that function's own docstring
    for the exact MATLAB citation), and is passed to exactly one `m_step`
    call (with `params_in=` for the zero-transition policy below); the
    resulting `params_out` is committed -- becomes the next mini-batch's own
    `params_in` -- before the loop continues. Never averages already-
    finalized parameters or statistics; never re-merges across mini-batches.

    **Zero-transition mini-batches** (`stats.n_transitions==0`, e.g. a
    mini-batch drawn entirely from `T=1` trials): `m_step`'s own
    `params_in=` argument makes it preserve `transition`/`coupling`
    UNCHANGED rather than dividing by zero or manufacturing uniform values
    -- see `m_step`'s own docstring. `pi_0` and every emission parameter
    still update normally.

    **Worker error trial indices are GLOBAL** (into `Y_trials`, not local to
    whichever mini-batch was running): `e_step`'s own `TrialExecutionError.
    trial_index` is local to the mini-batch's own trial list it was given,
    so a raised `TrialExecutionError` is caught here and re-raised with
    `trial_indices[local_index]` -- the actual position in the FULL dataset
    -- substituted in, so a caller debugging a large (e.g. ~100,000-trial)
    run learns which of ALL its trials failed, not merely which position
    within one mini-batch.

    **No persistent process pool.** Each mini-batch's `e_step` call creates
    and tears down its own `ProcessPoolExecutor` when `executor='process'`
    (P10b's own, already-bounded-memory, already-correct design) rather
    than this driver holding one open across mini-batches -- deliberately:
    `params`/`W` change every mini-batch (via `m_step`), and a
    `ProcessPoolExecutor`'s `initializer=` runs ONLY once, when a worker
    process starts, never again on a later `submit()` -- a persistent pool
    would need an explicit, verified per-mini-batch mechanism to refresh
    every already-running worker's cached `params`/`W` (e.g. deterministic
    worker-sized shards each re-initialized once per mini-batch, or
    resubmitting `initializer`-equivalent state to every worker and
    confirming every one of them picked it up) before it could safely claim
    any reuse-based speedup; that mechanism is not implemented here, so no
    such speedup is claimed for P10c -- `n_jobs=1` remains the default, and
    every worker in every mini-batch that DOES run in parallel is guaranteed
    to see the CURRENT `params`/`W` because it was started fresh for it.

    `backend="torch"` with `dtype="float32"` raises `UnsupportedCombination`
    (P10f, see `_reject_float32_training`)."""
    _reject_float32_training(backend, backend_options)
    if fb_constants is None:
        fb_constants = FbConstants()
    if raw_init_model:
        params = params.copy()
        params.pi_0 = apply_left2right_pi0_smoothing(params.pi_0, structure, left2right)

    num_trials = len(Y_trials)
    if num_trials == 0:
        raise ValueError("Y_trials must contain at least one trial")

    schedule = _resolve_schedule(
        Y_trials, max_iterations=max_iterations, num_minibatches=num_minibatches, shuffle=shuffle,
        random_state=random_state, schedule=schedule,
    )

    # Computed exactly ONCE, before any mini-batch's own E-step -- never
    # recomputed per mini-batch or per epoch (§P10c/P10d correction round;
    # see _run_one_minibatch_update's own docstring for why this matters at
    # the ~100,000-trial scale P10 targets).
    _resolve_start_method(start_method, executor)  # validate early (P10e)
    restore_trial_flags = _lock_trials_read_only(Y_trials)  # P10f: read-only while this run uses them
    try:
        global_nanvar = compute_global_nanvar(structure, Y_trials)  # validates every observation, once
        trials = _ValidatedTrials(Y_trials, structure)  # P10f: snapshot; internal E-steps skip re-validation

        result = MinibatchEmResult(params=params, schedule=schedule)

        for e, mbs in enumerate(schedule.epochs):
            for mb, trial_indices in enumerate(mbs):
                update = _run_one_minibatch_update(
                    structure, params, trials, trial_indices, e + 1, mb + 1, fb_constants, global_nanvar,
                    backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor,
                    matlab_compat=matlab_compat, validate=validate, start_method=start_method,
                )
                result.updates.append(update)
                params = update.params_out  # commit atomically before the next mini-batch's own E-step

        result.params = params
        return result
    finally:
        restore_trial_flags()


# ==========================================================================
# P10d: coherent end-of-epoch re-score, convergence, best-epoch selection,
# coherent pi_steady, and callbacks/progress on top of P10c's mechanical
# mini-batch scheduling/update primitives. Deliberately does NOT modify `em_lsim_
# minibatch`, `m_step`, `e_step`, or any other P10a/P10b/P10c code -- all
# are CLOSED, signed off. `em_lsim_minibatch_train` (below) reuses the same
# private `_resolve_schedule`/`_run_one_minibatch_update` helpers `em_lsim_
# minibatch` itself uses (§P10c/P10d correction round: an earlier version
# instead called the already-public `em_lsim_minibatch` once per epoch,
# which made it recompute `compute_global_nanvar` once per epoch instead of
# once per run, and made `minibatch_hook` fire only after each whole epoch
# had already committed rather than live, per mini-batch -- see `em_lsim_
# minibatch_train`'s own docstring for both).
# ==========================================================================


def _coherent_epoch_loglik(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    fb_constants: FbConstants,
    *,
    backend: str,
    backend_options: dict | None,
    n_jobs: int,
    executor: str | None,
    validate: str,
    start_method: str | None = None,
) -> float:
    """The coherent (single-snapshot) log-likelihood under `params`, summed
    over every trial in `Y_trials` -- §2.6's own "Epoch metrics" paragraph:
    "run a forward-only evaluation of every trial under that one final
    parameter snapshot."

    `backend='torch'` genuinely does this forward-only, via `forward_
    backward_batch(..., mode="loglik")` -- confirmed directly in `torch_
    batched.py`'s own `mode="loglik"` execution path: no backward
    recursion, no `alpha`/`beta`/`gamma`/`B`/`B_comp` transfer beyond the
    loglik values themselves (a P8a correction round exists specifically
    because an earlier version ran the full posterior computation for this
    mode and discarded everything but loglik -- the same mistake this
    function is careful not to repeat for Torch).

    `numpy`/`numba` now also run forward-only, via `run_backend_loglik`
    (`_forward_only_loglik`): the same validation, emissions, pi_0
    regularization and forward recursion as the posterior runners, summed
    over trials in the same order, so the value is bit-identical to the
    previous full `e_step(...).loglik` while skipping the backward recursion
    and `ExpectedStats` construction. The one exception is `validate="all"`,
    which keeps the full `e_step` path because its backward-side invariant
    checks need a backward pass. `benchmarks/bench_em_lsim_minibatch_train.py`
    measures the per-epoch cost."""
    if backend == "torch":
        from chmm_lsim.backends.torch_batched import forward_backward_batch

        loglik_per_trial = forward_backward_batch(
            structure, params, Y_trials, fb_constants,
            backend="torch", mode="loglik", validate=validate, **(backend_options or {}),
        )
        return float(np.sum(loglik_per_trial))

    if validate == "all":
        # validate="all" also checks backward-side invariants (gamma/abar/V2/f<=h),
        # which only a full forward+backward pass can evaluate -- keep that path.
        raw = e_step(
            structure, params, Y_trials, fb_constants,
            backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor, validate=validate,
            start_method=start_method,
        )
        return raw.loglik

    return _forward_only_loglik(
        structure, params, Y_trials, fb_constants, backend=backend, validate=validate, n_jobs=n_jobs, executor=executor,
        start_method=start_method,
    )


def _coherent_pi_steady(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    fb_constants: FbConstants,
    *,
    backend: str,
    backend_options: dict | None,
    n_jobs: int,
    executor: str | None,
    validate: str,
    sigma_diag: bool,
    start_method: str | None = None,
) -> NDArray[np.float64]:
    """The coherent (gamma-based, single-snapshot) `pi_steady` under
    `params`. Unlike loglik/AIC/BIC, this needs SMOOTHED `gamma`, so it
    cannot truthfully come from a forward-only pass at all, for any
    backend (§2.6's own "Epoch metrics" paragraph is explicit about this).
    Runs one full E-step (forward AND backward -- via the unmodified
    `e_step`, which already dispatches to `forward_backward_batch(...,
    mode="stats")` for `backend='torch'`) and finalizes it, purely to reach
    `gamma_sum`/`T_all`, discarding everything else. Must be called exactly
    ONCE per training run, under the SELECTED best-epoch snapshot -- never
    once per epoch, which is exactly the extra-backward-pass-every-epoch
    cost §2.6's own design exists to avoid: "This avoids an extra backward
    pass every epoch while ensuring EmResult.params and EmResult.pi_steady
    describe the same model.\""""
    raw = e_step(
        structure, params, Y_trials, fb_constants,
        backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor, validate=validate,
        start_method=start_method,
    )
    stats = finalize_expected_stats(raw, sigma_diag=sigma_diag)
    return stats.gamma_sum / stats.T_all


@dataclass
class MinibatchTrainingResult:
    """P10d's own driver result: `EmResult`-shaped coherent metrics
    (`loglik_trace`/`aic_trace`/`bic_trace`/best-epoch/`pi_steady`), one
    entry per EPOCH -- not per raw mini-batch update, which is what `Minibatch
    EmResult`/`MinibatchUpdate` (P10c) already record in full and are
    referenced here via `minibatch`, not duplicated. `params`/`pi_steady`/
    `best_epoch` describe the coherent BEST-EPOCH snapshot, evaluated the
    same way `EmResult.params`/`pi_steady`/`best_iterate` describe `em_lsim`'s
    own best-ITERATE snapshot -- "epoch" here is the exact analogue of
    `em_lsim`'s own "iteration" (confirmed by `num_minibatches=1`'s own
    non-regression equivalence, P10c)."""

    params: LSIMParams  # coherent best-epoch snapshot (NOT necessarily the last epoch's own params)
    best_epoch: int  # 1-based epoch index the snapshot came from
    pi_steady: NDArray[np.float64] | None = None  # (S,) gamma-based, evaluated once under the best-epoch snapshot
    loglik_trace: list[float] = field(default_factory=list)  # coherent per-epoch loglik, one per COMPLETED epoch
    aic_trace: list[float] = field(default_factory=list)
    bic_trace: list[float] = field(default_factory=list)
    n_epochs: int = 0  # number of epochs actually run (may be < the requested max_iterations if convergence fired)
    minibatch: "MinibatchEmResult | None" = None  # the complete P10c-level trace: every mini-batch's own update
    # P10e: which epochs were coherently evaluated. loglik_trace/aic_trace/bic_trace have exactly one entry per
    # element here, in order -- with a sparse coherent_eval_interval they are NOT one entry per training epoch.
    evaluated_epoch_indices: list[int] = field(default_factory=list)
    convergence: str = "legacy"  # effective policy: "legacy" | "robust" | "off"
    coherent_eval_interval: "int | str" = 1
    stop_reason: str = "max_iterations"  # "max_iterations" | "converged"


@dataclass(frozen=True)
class RobustConvergence:
    """Settings for `em_lsim_minibatch_train(convergence="robust")` (P10e).

    A plateau rule on the magnitude of change, suited to a mini-batch coherent
    trace that oscillates. An evaluated epoch counts as a convergence event
    only if its change from the previous evaluated epoch is SMALL in either
    direction: `|L_e - L_prev| < rel_tol * |L_prev|`. Any larger change -- an
    improvement, or a decrease of any size -- resets the count. Training stops
    once `patience` consecutive evaluated epochs are convergence events and at
    least `min_epochs` epochs have run.

    Consequences: a genuine plateau stops; steady improvement, a single large
    drop, the recovery after it, and a zig-zag with large swings all continue;
    a sustained large decline is NOT treated as convergence either (training
    runs to `max_iterations`, and best-epoch selection still returns the best
    evaluated snapshot). `rel_tol=0` never stops."""

    rel_tol: float = 1e-5
    patience: int = 3
    min_epochs: int = 10

    def __post_init__(self) -> None:
        if not (isinstance(self.rel_tol, (int, float)) and not isinstance(self.rel_tol, bool) and np.isfinite(self.rel_tol) and self.rel_tol >= 0):
            raise ValueError(f"RobustConvergence.rel_tol must be a finite float >= 0, got {self.rel_tol!r}")
        for name in ("patience", "min_epochs"):
            v = getattr(self, name)
            if isinstance(v, bool) or not isinstance(v, int) or v < 1:
                raise ValueError(f"RobustConvergence.{name} must be a positive int, got {v!r}")


_CONVERGENCE_POLICIES = ("legacy", "robust", "off")


def _legacy_convergence_stop(loglik_trace: list[float], epoch_idx: int) -> bool:
    """em_lsim.m's rule, unchanged: after epoch 9, stop when at least 2 of the
    last 5 epoch-to-epoch differences are < 0.001 (this counts ANY decrease).
    Indexed by epoch, so it is only defined for every-epoch evaluation."""
    if epoch_idx > 9:
        recent = np.diff(loglik_trace[epoch_idx - 6 : epoch_idx])
        return bool(np.sum(recent < 0.001) >= 2)
    return False


class _RobustConvergenceMonitor:
    def __init__(self, cfg: RobustConvergence):
        self.cfg = cfg
        self.previous: float | None = None
        self.small_changes = 0

    def update(self, epoch_idx: int, loglik: float) -> bool:
        prev = self.previous
        if prev is not None and np.isfinite(loglik) and np.isfinite(prev) and abs(loglik - prev) < self.cfg.rel_tol * abs(prev):
            self.small_changes += 1
        else:
            self.small_changes = 0
        self.previous = loglik
        return epoch_idx >= self.cfg.min_epochs and self.small_changes >= self.cfg.patience


def _resolve_convergence(check_convergence, convergence, coherent_eval_interval):
    if convergence is not None and convergence not in _CONVERGENCE_POLICIES:
        raise ValueError(f"convergence must be one of {_CONVERGENCE_POLICIES} or None, got {convergence!r}")
    if check_convergence is not _UNSET and not isinstance(check_convergence, bool):
        raise ValueError(f"check_convergence must be a bool, got {check_convergence!r}")
    if convergence is None:
        policy = "off" if check_convergence is False else "legacy"
    else:
        policy = convergence
        if check_convergence is not _UNSET and (check_convergence != (policy != "off")):
            raise ValueError(
                f"check_convergence={check_convergence!r} contradicts convergence={policy!r}; pass only convergence="
            )
    if isinstance(coherent_eval_interval, str):
        if coherent_eval_interval != "final":
            raise ValueError(f"coherent_eval_interval must be a positive int or 'final', got {coherent_eval_interval!r}")
    elif isinstance(coherent_eval_interval, bool) or not isinstance(coherent_eval_interval, (int, np.integer)) or coherent_eval_interval < 1:
        raise ValueError(f"coherent_eval_interval must be a positive int or 'final', got {coherent_eval_interval!r}")
    else:
        coherent_eval_interval = int(coherent_eval_interval)
    if coherent_eval_interval != 1 and policy != "off":
        raise ValueError(
            f"coherent_eval_interval={coherent_eval_interval!r} evaluates only some epochs; convergence is only defined for "
            f"every-epoch evaluation, so pass convergence='off' (or check_convergence=False)"
        )
    return policy, coherent_eval_interval


def em_lsim_minibatch_train(
    structure: LSIMStructure,
    params: LSIMParams,
    Y_trials: list[NDArray[np.float64]],
    *,
    max_iterations: int | None = None,
    num_minibatches: int | _Unset = _UNSET,
    shuffle: bool | _Unset = _UNSET,
    random_state: int | np.random.Generator | None | _Unset = _UNSET,
    schedule: MinibatchSchedule | None = None,
    fb_constants: FbConstants | None = None,
    backend: str = "numpy",
    backend_options: dict | None = None,
    n_jobs: int = 1,
    executor: str | None = None,
    matlab_compat: bool = True,
    check_convergence: "bool | _Unset" = _UNSET,
    validate: str = "params",
    left2right: bool = False,
    raw_init_model: bool = False,
    epoch_hook=None,
    minibatch_hook=None,
    convergence: str | None = None,
    robust_convergence: RobustConvergence | None = None,
    coherent_eval_interval: "int | str" = 1,
    start_method: str | None = None,
) -> MinibatchTrainingResult:
    """Coherent mini-batch training driver -- runs its own mini-batch loop directly
    (via the same private `_run_one_minibatch_update` helper `em_lsim_
    minibatch` (P10c) uses internally), and adds coherent end-of-epoch
    log-likelihood/AIC/BIC, convergence, best-epoch selection, coherent
    `pi_steady`, and callbacks/progress reporting on top. Does NOT call
    `em_lsim_minibatch` itself (a prior version did, once per epoch --
    changed in the §P10c/P10d correction round specifically so `minibatch_
    hook` can fire immediately after each mini-batch commits, before the
    next one starts, rather than only after `em_lsim_minibatch` had already
    finished an entire epoch -- see "Callbacks/progress" below). `em_lsim`,
    `e_step`, `m_step`, and `em_lsim_minibatch` itself remain completely
    unmodified either way.

    **Scheduling is resolved exactly as `em_lsim_minibatch` itself would**
    -- both now call the same shared `_resolve_schedule` helper, so this
    logic exists in exactly one place: either pass `schedule=` directly
    (e.g. a complete P10a golden fixture's own multi-epoch schedule, for
    exact replay including its own stored coherent metrics), or let this
    generate one from `max_iterations`/`num_minibatches`/`shuffle`/`random_
    state` (the same `_UNSET`-sentinel contract as `em_lsim_minibatch`:
    supplying any of those three together with an explicit `schedule=`
    raises, rather than being silently ignored).

    **`compute_global_nanvar` runs exactly ONCE per training run** (§P10c/
    P10d correction round: an earlier version called `em_lsim_minibatch`
    once per epoch, and `em_lsim_minibatch` itself calls `compute_global_
    nanvar` once per call -- meaning `max_iterations` whole-dataset variance
    scans instead of one, a real scalability defect this function's own
    contract explicitly disclaims at the ~100,000-trial scale P10 targets).
    Computed once, up front, and threaded through every epoch's own mini-
    batch updates via `_run_one_minibatch_update`. `T_all` (needed for
    `compute_aic_bic`) is computed AFTER `compute_global_nanvar` has already
    validated every trial -- not before, which would let a malformed `Y`
    (wrong shape/dtype, `Inf`, `T=0`) escape as a raw, unattributed indexing
    error instead of `compute_global_nanvar`'s own clear, per-trial-indexed
    `ValidationError`.

    **Coherent per-epoch evaluation.** After each epoch's mini-batches have
    all committed, `_coherent_epoch_loglik` evaluates every trial in
    `Y_trials` under that epoch's own single final parameter snapshot
    (forward-only for `backend='torch'`; a full E-step, discarding the
    backward pass's other outputs, for `numpy`/`numba` -- see that
    function's own docstring for why), and `compute_aic_bic` derives
    AIC/BIC from it. This -- not `MinibatchEmResult.training_batch_loglik_
    by_epoch`, the MIXED pre-update diagnostic P10c already exposes -- is
    what populates `loglik_trace`/`aic_trace`/`bic_trace` here, convergence,
    and best-epoch selection: every entry describes one single, coherent
    parameter snapshot, never a mix of pre-update mini-batch scores.

    **Convergence and best-epoch selection reproduce `em_lsim`'s own exact
    rule, at epoch granularity** (confirmed identical to `em_lsim`'s own
    iteration-level logic in `tests/test_em_minibatch_train.py`, using the
    same monkeypatch methodology `tests/test_em.py` established for
    `em_lsim` itself): convergence is checked BEFORE the best-epoch
    snapshot, using the last 6 entries of `loglik_trace` (5 diffs) once
    `epoch_idx > 9`, breaking if at least 2 of those 5 diffs are `<0.001` --
    a `break` here means the loop stops with NO further epochs run (their
    updates never happen at all, unlike `em_lsim`'s own per-ITERATION break,
    which only skips that iteration's own best-iterate snapshot after
    having already computed it -- there is no equivalent "partially-run
    epoch" here since an epoch's own mini-batch updates always complete in
    full before its coherent evaluation runs) and excludes that final
    epoch's own snapshot from best-epoch consideration, exactly like
    `em_lsim`. Best-epoch selection is the same `epoch_idx>2` argmax rule
    (`epoch_idx` in `{1,2}` unconditionally overwrites the running best).

    **Coherent `pi_steady`** is evaluated exactly ONCE, via `_coherent_
    pi_steady`, under the SELECTED best-epoch's own final snapshot -- never
    once per epoch, avoiding an extra backward pass on every epoch just to
    track a metric only the winning snapshot ultimately needs.

    **Callbacks/progress -- genuinely live, not retrospective (§P10c/P10d
    correction round).** `minibatch_hook(epoch_idx, minibatch_idx, update:
    MinibatchUpdate)` fires IMMEDIATELY after each mini-batch commits --
    before the next mini-batch's own E-step begins, not merely after the
    whole epoch containing it has finished (a prior version of this
    function called `em_lsim_minibatch` for an entire epoch at once and
    fired every one of that epoch's own `minibatch_hook` calls only
    afterward, which is retrospective notification, not progress: on a
    large epoch it could stay silent for a long time, and if a LATER
    mini-batch in that epoch then failed, hooks for EARLIER, already-
    committed mini-batches would never fire at all). Now: if mini-batch `u`
    fails, every mini-batch before it in the same epoch has ALREADY had its
    own `minibatch_hook` call delivered (its update was already committed
    and its hook already fired, both before mini-batch `u` even started).
    If `minibatch_hook` itself raises, that exception propagates immediately
    -- no later mini-batch, and no epoch-level coherent evaluation for the
    epoch in progress, ever runs. `update.epoch_idx`/`minibatch_idx` are the
    TRUE global values (no renumbering needed -- unlike the prior
    implementation, this one never delegates to a one-epoch `em_lsim_
    minibatch` call that would otherwise always report `epoch_idx=1`).
    `epoch_hook(epoch_idx, params, coherent_loglik, aic, bic)` fires once
    per completed epoch, after its own coherent evaluation, mirroring
    `em_lsim`'s own `iter_hook(itr, params, loglik, aic, bic)` call
    signature (one fewer positional argument only because there is no
    epoch-level analogue of `em_lsim`'s per-iteration mixed-parameter
    concept to also pass).

    **Convergence policy (P10e).** `convergence=None` (default) keeps the
    previous behaviour exactly: `check_convergence=True` (its default) means
    `"legacy"`, `check_convergence=False` means `"off"`. Explicit choices:

    - `"legacy"`: `em_lsim.m`'s rule -- after epoch 9, stop when >=2 of the
      last 5 epoch deltas are < 0.001. It counts any decrease, of any size, as
      a convergence event, so on an oscillating mini-batch coherent trace it
      can stop while the trend is still improving. Kept for compatibility.
    - `"robust"`: stop after `patience` consecutive evaluated epochs whose
      change is small in either direction (`RobustConvergence`); a large
      decrease resets the count and is never treated as convergence. The
      current epoch is considered for best-epoch selection before the stop
      decision.
    - `"off"`: always run every scheduled epoch.

    `check_convergence` and `convergence` may be passed together only if they
    agree. `em_lsim` (full batch) is unchanged.

    **Coherent evaluation cadence (P10e, opt-in optimization).**
    `coherent_eval_interval=1` (default) evaluates every epoch -- exactly the
    previous behaviour. An int `k > 1` evaluates epochs `k, 2k, ...` plus the
    final scheduled epoch; `"final"` evaluates only the final scheduled epoch.
    Anything other than 1 requires `convergence="off"`. Mini-batch updates are
    identical whatever the cadence; only which snapshots are scored changes.
    `evaluated_epoch_indices` lists the evaluated epochs, and
    `loglik_trace`/`aic_trace`/`bic_trace` have one entry per EVALUATED epoch.
    Best-epoch selection only ever chooses an evaluated snapshot, and
    `epoch_hook` fires only for evaluated epochs (non-evaluated epochs have no
    coherent loglik to report; use `minibatch_hook` for per-update progress).
    Only the current best snapshot is retained, so memory does not grow with
    the number of skipped evaluations.

    **Process start method (P10e).** With `executor="process"`, pools use
    `start_method` (default `None`: "spawn"; see `_resolve_start_method` for
    the measured forkserver/fork crashes). Pass "forkserver" or "fork" only
    deliberately."""
    _reject_float32_training(backend, backend_options)  # P10f
    policy, coherent_eval_interval = _resolve_convergence(check_convergence, convergence, coherent_eval_interval)
    _resolve_start_method(start_method, executor)  # validate early (P10e)
    if robust_convergence is not None and policy != "robust":
        raise ValueError(f"robust_convergence settings were given but convergence={policy!r}")
    robust_monitor = _RobustConvergenceMonitor(robust_convergence or RobustConvergence()) if policy == "robust" else None
    if fb_constants is None:
        fb_constants = FbConstants()
    if raw_init_model:
        params = params.copy()
        params.pi_0 = apply_left2right_pi0_smoothing(params.pi_0, structure, left2right)

    num_trials = len(Y_trials)
    if num_trials == 0:
        raise ValueError("Y_trials must contain at least one trial")
    sigma_diag = params.sigma_diag

    full_schedule = _resolve_schedule(
        Y_trials, max_iterations=max_iterations, num_minibatches=num_minibatches, shuffle=shuffle,
        random_state=random_state, schedule=schedule,
    )

    # Computed exactly ONCE, before any epoch's own mini-batch updates --
    # never recomputed per epoch. Also validates every trial (raises a
    # clear, per-trial-indexed ValidationError for a malformed Y), so T_all
    # below is safe to compute with a plain, unvalidating sum().
    restore_trial_flags = _lock_trials_read_only(Y_trials)  # P10f: read-only while this run uses them
    try:
        global_nanvar = compute_global_nanvar(structure, Y_trials)
        trials = _ValidatedTrials(Y_trials, structure)  # P10f: validated snapshot; internal E-steps/scoring skip re-validation
        T_all = sum(int(Y.shape[1]) for Y in Y_trials)

        all_updates: list[MinibatchUpdate] = []
        loglik_trace: list[float] = []
        aic_trace: list[float] = []
        bic_trace: list[float] = []
        evaluated_epochs: list[int] = []
        best_loglik = -np.inf
        best_params = params
        best_epoch = 0
        n_epochs_run = 0
        stop_reason = "max_iterations"
        n_scheduled = len(full_schedule.epochs)

        for e, mbs in enumerate(full_schedule.epochs):
            epoch_idx = e + 1
            for mb, trial_indices in enumerate(mbs):
                update = _run_one_minibatch_update(
                    structure, params, trials, trial_indices, epoch_idx, mb + 1, fb_constants, global_nanvar,
                    backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor,
                    matlab_compat=matlab_compat, validate=validate, start_method=start_method,
                )
                all_updates.append(update)
                params = update.params_out  # commit IMMEDIATELY -- before the hook, and before the next mini-batch

                if minibatch_hook is not None:
                    minibatch_hook(epoch_idx, update.minibatch_idx, update)

            n_epochs_run = epoch_idx

            if not (coherent_eval_interval == 1 or epoch_idx == n_scheduled
                    or (coherent_eval_interval != "final" and epoch_idx % coherent_eval_interval == 0)):
                continue  # not a scheduled evaluation: no coherent score, no hook, not a best-epoch candidate

            coherent_loglik = _coherent_epoch_loglik(
                structure, params, trials, fb_constants,
                backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor, validate=validate,
                start_method=start_method,
            )
            aic, bic = compute_aic_bic(structure, sigma_diag, coherent_loglik, T_all)
            loglik_trace.append(coherent_loglik)
            aic_trace.append(aic)
            bic_trace.append(bic)
            evaluated_epochs.append(epoch_idx)

            if epoch_hook is not None:
                epoch_hook(epoch_idx, params, coherent_loglik, aic, bic)

            # Legacy convergence is checked BEFORE the best-epoch snapshot (em_lsim.m's/
            # em_lsim's own order): a `break` here excludes this epoch's own
            # snapshot from best-epoch consideration entirely.
            if policy == "legacy" and _legacy_convergence_stop(loglik_trace, epoch_idx):
                stop_reason = "converged"
                break

            if epoch_idx > 2:
                if coherent_loglik > best_loglik:
                    best_loglik = coherent_loglik
                    best_params = params
                    best_epoch = epoch_idx
            else:
                best_loglik = coherent_loglik
                best_params = params
                best_epoch = epoch_idx

            if robust_monitor is not None and robust_monitor.update(epoch_idx, coherent_loglik):
                stop_reason = "converged"
                break

        best_pi_steady = _coherent_pi_steady(
            structure, best_params, trials, fb_constants,
            backend=backend, backend_options=backend_options, n_jobs=n_jobs, executor=executor, validate=validate,
            sigma_diag=sigma_diag, start_method=start_method,
        )

        executed_schedule = MinibatchSchedule(epochs=full_schedule.epochs[:n_epochs_run])
        minibatch_result = MinibatchEmResult(params=params, schedule=executed_schedule, updates=all_updates)

        return MinibatchTrainingResult(
            params=best_params,
            best_epoch=best_epoch,
            pi_steady=best_pi_steady,
            loglik_trace=loglik_trace,
            aic_trace=aic_trace,
            bic_trace=bic_trace,
            n_epochs=n_epochs_run,
            minibatch=minibatch_result,
            evaluated_epoch_indices=evaluated_epochs,
            convergence=policy,
            coherent_eval_interval=coherent_eval_interval,
            stop_reason=stop_reason,
        )
    finally:
        restore_trial_flags()
